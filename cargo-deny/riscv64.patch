--- PKGBUILD
+++ PKGBUILD
@@ -34,6 +34,8 @@
 
 check() {
   cd "$pkgname-$pkgver"
+  # Build-script checks exceed the default 30-second test deadline on riscv64.
+  export CARGO_DENY_TEST_TIMEOUT_SECS=160
   # https://github.com/EmbarkStudios/cargo-deny/issues/816
   CARGO_HOME=/build/.cargo ZSTD_SYS_USE_PKG_CONFIG=1 cargo test --frozen
 }
