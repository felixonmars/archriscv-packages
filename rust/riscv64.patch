--- PKGBUILD
+++ PKGBUILD
@@ -185,6 +185,10 @@
   export RUST_BACKTRACE=1
   unset CFLAGS CXXFLAGS LDFLAGS
 
+  if [[ $CARCH = riscv64 ]]; then
+    export RUSTFLAGS+=" -C link-arg=-fuse-ld=lld"
+  fi
+
   local xpy_options=(
     -j "$(nproc)"
   )
@@ -280,6 +284,8 @@
     loong64|riscv64)
       _pick dest-aarch64-gnu usr/lib/rustlib/aarch64-unknown-linux-gnu
       _pick dest-aarch64-musl usr/lib/rustlib/aarch64-unknown-linux-musl
+      _pick dest-x86_64-gnu usr/lib/rustlib/x86_64-unknown-linux-gnu
+      _pick dest-x86_64-musl usr/lib/rustlib/x86_64-unknown-linux-musl
       ;;
   esac
 }
@@ -401,4 +407,44 @@
   _install_licenses
 }
 
+package_rust-x86_64-gnu() {
+  pkgdesc="x86_64 GNU target for Rust"
+  arch=(
+    loong64
+    riscv64
+  )
+  depends=(
+    x86_64-linux-gnu-gcc
+    x86_64-linux-gnu-glibc
+    rust
+  )
+
+  cp -a dest-x86_64-gnu/* "$pkgdir"
+  _install_licenses
+}
+
+package_rust-x86_64-musl() {
+  pkgdesc="x86_64 Musl target for Rust"
+  arch=(
+    loong64
+    riscv64
+  )
+  depends=(
+    x86_64-linux-gnu-gcc
+    rust
+  )
+
+  cp -a dest-x86_64-musl/* "$pkgdir"
+  _install_licenses
+}
+
+pkgname+=(rust-x86_64-gnu rust-x86_64-musl)
+makedepends_loong64+=(x86_64-linux-gnu-gcc x86_64-linux-gnu-glibc)
+makedepends_riscv64+=(libatomic x86_64-linux-gnu-gcc x86_64-linux-gnu-glibc)
+b2sums_loong64[0]='f24b9b5c46b80b0b029610884e4b3e11cd63804cfadac1dec88fce8cc19fd38c4201645895acffabeffbf88006b200b2f62ae5308f847e5a875d3ed0b49a92a4'
+b2sums_riscv64[0]='312462428f76ffad44bb97ef7b4a428d3b42e95cbce1dc578af74f303c7f0337e4e6140876ebbae098837fa6fd5f8af7cb0f07343728aabfa377d07f21a3c767'
+if [[ $CARCH = riscv64 ]]; then
+  makedepends=(${makedepends[@]/rust})
+fi
+
