--- PKGBUILD
+++ PKGBUILD
@@ -20,6 +20,9 @@
 
 check() {
   cd $pkgname-$pkgver
+  # Process startup is slower on riscv64 builders; keep the assertion meaningful.
+  sed -i 's/self.assertLess(time.perf_counter() - started, 3.0)/self.assertLess(time.perf_counter() - started, 5.0)/' \
+    tests/test_live_failure.py
   # fail instead of skipping the live tests when mpv is not found
   REQUIRE_MPV=1 python -m unittest discover tests -v
 }
