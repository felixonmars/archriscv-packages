--- PKGBUILD
+++ PKGBUILD
@@ -79,8 +79,9 @@
 }
 
 check() {
+  # Allow the full suite to finish on slower riscv64 builders.
   dbus-run-session xvfb-run -s '-nolisten local' \
-    meson test -C build --print-errorlogs
+    meson test -C build --print-errorlogs --timeout-multiplier 5
 }
 
 package(){
@@ -91,3 +92,10 @@
   # add missing html doc
   cp -arv build/doc/html "$pkgdir/usr/share/doc/$pkgname/"
 }
+
+source+=(geeqie-lua-ready.patch)
+sha256sums+=('9ef051cd00510b6ffbfe9756c3f6827ebd25db9b6f37cab446e834d80cc22278')
+
+prepare() {
+  patch -Np1 -d "$pkgname-$pkgver" -i ../geeqie-lua-ready.patch
+}
