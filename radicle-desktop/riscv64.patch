--- PKGBUILD
+++ PKGBUILD
@@ -39,10 +39,30 @@
   cd "${pkgname}"
   cargo fetch --locked --target host-tuple
   npm ci
+
+  cd "$srcdir/rolldown-1.1.5"
+  CARGO_HOME="$srcdir/cargo-home" \
+    cargo fetch --locked --target riscv64gc-unknown-linux-gnu
+
+  cd "$srcdir/lightningcss-1.32.0"
+  CARGO_HOME="$srcdir/cargo-home" \
+    cargo fetch --locked --target riscv64gc-unknown-linux-gnu
 }
 
 build() {
-  cd "${pkgname}"
+  cd "$srcdir/rolldown-1.1.5"
+  CARGO_HOME="$srcdir/cargo-home" CFLAGS="$CFLAGS -ffat-lto-objects" \
+    cargo build --frozen --release -p rolldown_binding --target riscv64gc-unknown-linux-gnu
+
+  cd "$srcdir/lightningcss-1.32.0"
+  CARGO_HOME="$srcdir/cargo-home" \
+    cargo build --frozen --release -p lightningcss_node --target riscv64gc-unknown-linux-gnu
+
+  cd "$srcdir/${pkgname}"
+  install -m755 "$srcdir/rolldown-1.1.5/target/riscv64gc-unknown-linux-gnu/release/librolldown_binding.so" \
+    node_modules/rolldown/dist/shared/rolldown-binding.linux-riscv64-gnu.node
+  install -m755 "$srcdir/lightningcss-1.32.0/target/riscv64gc-unknown-linux-gnu/release/liblightningcss_node.so" \
+    node_modules/lightningcss/lightningcss.linux-riscv64-gnu.node
   export CFLAGS+=" -ffat-lto-objects"
   cargo tauri build -b deb --ci
 }
