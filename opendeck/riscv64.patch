--- PKGBUILD
+++ PKGBUILD
@@ -59,14 +59,33 @@
   # download rust dependencies
   cd src-tauri
   cargo fetch --locked --target host-tuple
+  mv "$srcdir/lightningcss-6993d9f1d3cd69030c5976cd8860361b7679f68d" "$srcdir/lightningcss-1.31.1"
+  for version in 1.30.2 1.31.1; do
+    cargo fetch --locked --manifest-path="$srcdir/lightningcss-$version/node/Cargo.toml"
+  done
+  cargo fetch --locked --manifest-path="$srcdir/tailwindcss-4.1.18/crates/node/Cargo.toml"
 }
 build() {
   cd "$pkgname"
 
+  # Build native bindings to avoid the RISC-V V8 crash in Lightning CSS WASM.
+  for version in 1.30.2 1.31.1; do
+    cargo build --frozen --release --manifest-path="$srcdir/lightningcss-$version/node/Cargo.toml"
+    cp "$srcdir/lightningcss-$version/target/release/liblightningcss_node.so" \
+      "node_modules/.deno/lightningcss@$version/node_modules/lightningcss/lightningcss.linux-riscv64-gnu.node"
+  done
+
+  # Tailwind does not publish native riscv64 Oxide bindings.
+  cargo build --frozen --release --manifest-path="$srcdir/tailwindcss-4.1.18/crates/node/Cargo.toml"
+  cp "$srcdir/tailwindcss-4.1.18/target/release/libtailwind_oxide.so" \
+    "$srcdir/tailwindcss-oxide.node"
+  NAPI_RS_NATIVE_LIBRARY_PATH="$srcdir/tailwindcss-oxide.node" \
+    deno run -A node_modules/vite/bin/vite.js build
+
   # disable update check
   export OPENDECK_DISABLE_UPDATE_CHECK=1
 
-  deno task tauri build --bundles deb -- --frozen
+  deno task tauri build --bundles deb --config '{"build":{"beforeBuildCommand":null}}' -- --frozen
 }
 
 package() {
@@ -74,3 +93,13 @@
 
   cp -a src-tauri/target/release/bundle/deb/opendeck_*/data/* "$pkgdir"
 }
