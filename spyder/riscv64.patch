--- PKGBUILD
+++ PKGBUILD
@@ -126,6 +126,7 @@
   cd $pkgname
 # fix tests with pytest 9.2
   patch -p1 -i ../pytest-9.2.patch
+  patch -Np0 -i "$srcdir/tests-riscv64.patch"
 }
 
 build() {
@@ -197,7 +198,8 @@
   )
   export PYTEST_QT_API="pyqt6"
   export CI=true
-  xvfb-run pytest "${pytest_args[@]}" -vv
+  # Chromium's sandbox aborts the renderer: Current process is not mono-threaded!
+  QTWEBENGINE_DISABLE_SANDBOX=1 xvfb-run pytest "${pytest_args[@]}" -vv
 }
 
 package() {
@@ -207,3 +209,6 @@
   install -vDm644 -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/" \
     spyder/images/spyder.svg
 }
+
+source+=(tests-riscv64.patch)
+b2sums+=('2b6c99e521d238107b715d124f59041c3f9fd5c6f15a12e392881ad899a98ed8a9ce4d068e547d6ea350bc0a43ca8cea69efee5e4b96cbaf5c4c8abc9bc0fa06')
