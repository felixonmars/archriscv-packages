--- PKGBUILD
+++ PKGBUILD
@@ -29,12 +29,23 @@
 prepare() {
   cd prometheus-$pkgver
 
+  patch -Np1 -i "$srcdir/discovery-test.patch"
+
   # https://github.com/prometheus/prometheus/issues/18471
   rm util/runtime/statfs_unix_test.go
+
+  printf '\noverrides:\n  lightningcss: npm:lightningcss-wasm@1.33.0\n' >> web/ui/pnpm-workspace.yaml
+  pnpm --dir web/ui install --no-frozen-lockfile
+
+  cd "$srcdir/rolldown-1.2.7"
+  cargo fetch --locked --target riscv64gc-unknown-linux-gnu
 }
 
 build() {
-  cd prometheus-$pkgver
+  cd "$srcdir/rolldown-1.2.7"
+  cargo build --frozen --release -p rolldown_binding --target riscv64gc-unknown-linux-gnu
+
+  cd "$srcdir/prometheus-$pkgver"
 
   LDFLAGS="-extldflags '$LDFLAGS' \
     -X github.com/prometheus/common/version.Version=$pkgver \
@@ -49,6 +60,8 @@
   cd $srcdir/prometheus-$pkgver
   # Build the react app
   make ui-install # run install first as otherwise the makefile has a race condition......
+  install -m755 "$srcdir/rolldown-1.2.7/target/riscv64gc-unknown-linux-gnu/release/librolldown_binding.so" \
+    web/ui/node_modules/.pnpm/rolldown@1.2.7/node_modules/rolldown/dist/shared/rolldown-binding.linux-riscv64-gnu.node
   make assets
   make assets-compress
 
@@ -72,7 +85,7 @@
   cd prometheus-$pkgver
 
   # TestHeadCompactionWhileScraping: https://github.com/prometheus/prometheus/issues/17956
-  go test -short -skip TestHeadCompactionWhileScraping ./...
+  go test -short -p 1 -parallel 1 -timeout 2h -skip TestHeadCompactionWhileScraping ./...
 }
 
 package() {
@@ -93,3 +106,9 @@
   # Examples
   install -Dm644 -t "$pkgdir"/usr/share/doc/prometheus/examples documentation/examples/prometheus*.yml
 }
+
+makedepends+=('rust' 'cmake')
+source+=('rolldown-1.2.7.tar.gz::https://github.com/rolldown/rolldown/archive/refs/tags/v1.2.7.tar.gz'
+         'discovery-test.patch')
