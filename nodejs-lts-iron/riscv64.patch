--- PKGBUILD
+++ PKGBUILD
@@ -32,6 +32,8 @@
 
 prepare() {
   cd node-v${pkgver}
+  patch -Np1 -i ../openssl-tests.patch
+  patch -Np1 -i ../http-keep-alive-empty-line.patch
   # Update ICU tests https://github.com/nodejs/node/pull/60523
   patch -Np1 -i ../update-icu-tests.patch
 }
@@ -80,7 +82,8 @@
 
   rm test/parallel/test-http-client-close-with-default-agent.js
 
-  make test-only
+  # Limit subprocess contention and raise the runner timeout on riscv64.
+  make test-only JOBS=2 TEST_CI_ARGS=--timeout=480
 
 }
 
@@ -90,3 +93,8 @@
   make DESTDIR="${pkgdir}" install
   install -Dm644 LICENSE -t "${pkgdir}"/usr/share/licenses/${pkgname}/
 }
