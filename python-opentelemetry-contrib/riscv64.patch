--- PKGBUILD
+++ PKGBUILD
@@ -197,6 +197,12 @@
 
 prepare() {
   cd opentelemetry-python-contrib
+  # Wait for ASGI responses, restore propagators and make metric timing deterministic.
+  patch -p1 -i "$srcdir/asgi-metric-timing.patch"
+  # Exclude client and scheduling overhead from Django metric expectations.
+  patch -p1 -i "$srcdir/django-metric-timing.patch"
+  # Allow client/server timing overhead on slower builders, following upstream #4665.
+  patch -p1 -i "$srcdir/tornado-metric-timing.patch"
   # Update tests for Starlette's routing API and metric attributes.
   patch -p1 -i "$srcdir/starlette-tests.patch"
   # Disable native FastAPI telemetry in tests of the contrib instrumentor.
@@ -931,3 +937,8 @@
   cd opentelemetry-python-contrib/instrumentation/opentelemetry-instrumentation-wsgi
   python -m installer --destdir="$pkgdir" dist/*.whl
 }
+
+source+=(asgi-metric-timing.patch django-metric-timing.patch tornado-metric-timing.patch)
