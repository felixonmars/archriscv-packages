--- PKGBUILD
+++ PKGBUILD
@@ -37,6 +37,7 @@
              node-gyp
              nodejs
              postgresql
+             protobuf
              # ruby-rake
              rust
              yarn)
@@ -85,7 +86,22 @@
 _datadir=/var/lib/gitlab # directory with gitlab data and it also $HOME for 'gitlab' user
 _logdir=/var/log/gitlab
 
+_rbtrace_version=0.5.3
+_glaz_revision=e1100ed8d93b3db58627229b7c4e16e29905a3d0
+source+=("git+https://github.com/tmm1/rbtrace.git#tag=v${_rbtrace_version}"
+         "git+https://gitlab.com/gitlab-org/auth/glaz.git#commit=${_glaz_revision}"
+         "glaz-proto-honor-protoc.patch")
+sha256sums+=('3b303a9d85b190c96e84c7b05a9ab0b39b95a201f3bc96ced9c36c6f13c3ab4d'
+            '9b6e48ea2327b383d4282cff52a0980cb94434c758a8e5a8e6559127285d79f0'
+            '722e7f0e10f6c35c4dfb6fa9fbdb5efc3c0a6499f7f081702460067fa83773b7')
+
 prepare() {
+	# Refresh rbtrace's bundled msgpack config.guess and config.sub for riscv64.
+	sed -Ei '/^([[:space:]]*)Dir.chdir\(dir\) do/a\      sys("autoreconf -fi")' rbtrace/ext/extconf.rb
+	patch -d glaz -p0 -i "$srcdir/glaz-proto-honor-protoc.patch"
+	mkdir -p .cargo
+	printf 'paths = ["%s"]\n' "$srcdir/glaz/crates/glaz-proto" > .cargo/config.toml
+
 	cd gitlab-foss
 
 	# GitLab tries to read its revision information from a file.
@@ -116,6 +132,12 @@
 }
 
 build() {
+	export PROTOC=/usr/bin/protoc
+
+	cd rbtrace
+	gem build rbtrace.gemspec
+	cd ..
+
 	cd gitlab-foss
 
 	# https://github.com/nodejs/node/issues/48444
@@ -139,13 +161,23 @@
 	bundle config --local force_ruby_platform true # some native gems are not available for newer ruby
 	bundle config --local deployment true
 	bundle config --local without 'development test aws kerberos'
+	bundle config --local build.nokogiri "--use-system-libraries --enable-shared --disable-static --with-cflags='-O2'"
+
+	# Replace rbtrace with the copy patched above.
+	export GEM_HOME=$HOME/.gem
+	bundle config --local cache_path vendor/cache/
+	bundle cache --no-install
+	cp ../rbtrace/rbtrace-${_rbtrace_version}.gem vendor/cache/
+	rbtrace_checksum=$(sha256sum vendor/cache/rbtrace-${_rbtrace_version}.gem)
+	sed -Ei "s/(  rbtrace \\(${_rbtrace_version}\\) sha256=)[[:alnum:]]*/\\1${rbtrace_checksum:0:64}/" Gemfile.lock
+
 	# Disable make jobserver due to a race in prometheus-client-mmap
 	# Use clang-21 as clang-22 is incomaptible with rb-sys < 0.9.125 used by prometheus-client-mmap and magnus
 	env \
 		MAKEFLAGS= \
 		CLANG_PATH=/usr/lib/llvm21/bin/clang-21 \
 		BUNDLER_CHECKSUM_VERIFICATION_OPT_IN=1 \
-		bundle install --jobs=$(nproc) --no-cache
+		bundle install --local --jobs=$(nproc) --no-cache
 
 	export CGO_CPPFLAGS="${CPPFLAGS}"
 	export CGO_CFLAGS="${CFLAGS}"
