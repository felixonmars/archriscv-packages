--- PKGBUILD
+++ PKGBUILD
@@ -19,6 +19,27 @@
 
+prepare() {
+  cd rolldown-1.2.13
+  cargo fetch --locked --target riscv64gc-unknown-linux-gnu
+
+  cd "$srcdir/lightningcss-1.33.0"
+  cargo fetch --locked --target riscv64gc-unknown-linux-gnu
+}
+
 build() {
-  cd fluidd
-  pnpm install --frozen-lockfile
-  pnpm run build
+  cd rolldown-1.2.13
+  CFLAGS="$CFLAGS -ffat-lto-objects" \
+    cargo build --frozen --release -p rolldown_binding --target riscv64gc-unknown-linux-gnu
+
+  cd "$srcdir/lightningcss-1.33.0"
+  cargo build --frozen --release -p lightningcss_node --target riscv64gc-unknown-linux-gnu
+
+  cd "$srcdir/fluidd"
+  # Use packaged pnpm with the metadata-timeout fix, not the upstream pin.
+  # https://github.com/pnpm/pnpm/pull/12519
+  pnpm --pm-on-fail=ignore install --frozen-lockfile --no-runtime
+  install -m755 ../rolldown-1.2.13/target/riscv64gc-unknown-linux-gnu/release/librolldown_binding.so \
+    node_modules/.pnpm/rolldown@1.2.13/node_modules/rolldown/dist/shared/rolldown-binding.linux-riscv64-gnu.node
+  install -m755 ../lightningcss-1.33.0/target/riscv64gc-unknown-linux-gnu/release/liblightningcss_node.so \
+    node_modules/.pnpm/lightningcss@1.33.0/node_modules/lightningcss/lightningcss.linux-riscv64-gnu.node
+  pnpm --pm-on-fail=ignore run build
 }
