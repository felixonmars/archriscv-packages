--- PKGBUILD
+++ PKGBUILD
@@ -57,12 +57,26 @@
 	CFLAGS+=' -ffat-lto-objects'
 	CXXFLAGS+=' -ffat-lto-objects'
 	RUSTFLAGS+=" --remap-path-prefix $PWD=/"
+	CFLAGS="${CFLAGS/-fstack-clash-protection}"
+	CXXFLAGS="${CXXFLAGS/-fstack-clash-protection}"
+	# Chromium selects additional ISA extensions for individual source files.
+	CFLAGS="${CFLAGS/-march=rv64gc }"
+	CXXFLAGS="${CXXFLAGS/-march=rv64gc }"
 	export LIBSQLITE3_SYS_USE_PKG_CONFIG=1
 	export ZSTD_SYS_USE_PKG_CONFIG=1
 }
 
 prepare() {
 	_srcenv
+	patch -Np1 -i ../minidumper-riscv64.patch
+	patch -Np1 -d .. -i "$srcdir/minidump-riscv64.patch"
+	mkdir -p ../livekit-rust-sdks/webrtc-sys/libwebrtc/ffmpeg-scripts
+	cp -a ../chromium-mirror/media/ffmpeg/scripts/. ../livekit-rust-sdks/webrtc-sys/libwebrtc/ffmpeg-scripts/
+	install -m644 ../chromium-mirror/third_party/devscripts/licensecheck.pl ../livekit-rust-sdks/webrtc-sys/libwebrtc/licensecheck.pl
+	install -m644 ../rtp-config-riscv64.patch ../livekit-rust-sdks/webrtc-sys/libwebrtc/rtp-config-riscv64.patch
+	install -m644 ../pipewire-riscv64.patch ../livekit-rust-sdks/webrtc-sys/libwebrtc/pipewire-riscv64.patch
+	patch -Np1 -d ../livekit-rust-sdks -i "$srcdir/livekit-riscv64.patch"
+	cargo update -p minidump-common -p minidump-writer -p process-backend -p livekit -p libwebrtc -p webrtc-sys
 	cargo fetch --locked --target host-tuple
 	export DO_STARTUP_NOTIFY="true"
 	export APP_ICON="zed"
@@ -80,6 +94,11 @@
 
 build() {
 	_srcenv
+	pushd "$srcdir/livekit-rust-sdks/webrtc-sys/libwebrtc"
+	export CC=clang CXX=clang++ AR=ar NM=nm
+	./build_linux.sh --arch riscv64
+	export LK_CUSTOM_WEBRTC="$PWD/linux-riscv64-release"
+	popd
 	export ZED_UPDATE_EXPLANATION='Updates are handled by pacman'
 	export RELEASE_VERSION="$pkgver"
 	export PROTOC=/usr/bin/protoc
@@ -117,3 +136,35 @@
 	install -Dm0644 completions.fish "$pkgdir/usr/share/fish/vendor_completions.d/$_binname.fish"
 	install -Dm0644 completions.zsh "$pkgdir/usr/share/zsh/site-functions/_$_binname"
 }
+
+# Native desktop-capture linkage replaces architecture-specific dlopen stubs.
+depends+=(libdrm libxcomposite libxdamage libxext libxfixes libxrandr mesa)
+makedepends+=(cpio
+              gn
+              lld
+              llvm
+              ninja
+              opus
+              pipewire
+              pulseaudio # needed to build libwebrtc, not at runtime
+              python-httplib2)
+source+=("git+https://github.com/zed-industries/livekit-rust-sdks.git#commit=0a1c519cfce9b365229026b55de9b9dbdb6fed3c"
+         "minidump-common-0.26.1.tar.gz::https://static.crates.io/crates/minidump-common/minidump-common-0.26.1.crate"
+         "minidump-writer-0.13.0.tar.gz::https://static.crates.io/crates/minidump-writer/minidump-writer-0.13.0.crate"
+         "process-backend-0.1.0.tar.gz::https://static.crates.io/crates/process-backend/process-backend-0.1.0.crate"
+         "chromium-mirror::git+https://github.com/chromium/chromium.git#commit=254bc711794d7ad269495f3d419a209935b78cad"
+         minidumper-riscv64.patch
+         minidump-riscv64.patch
+         livekit-riscv64.patch
+         rtp-config-riscv64.patch
+         pipewire-riscv64.patch)
