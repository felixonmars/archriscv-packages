@@ -0,0 +1,50 @@
+use {
+    super::{CpuInfoError, ProcessInspector},
+    crate::minidump_format::*,
+    std::{collections::HashSet, io::Read},
+};
+
+fn parse_cpus_from_sysfile(mut file: impl Read) -> Result<HashSet<u32>, CpuInfoError> {
+    let mut cpus = HashSet::new();
+    let mut content = String::new();
+    file.read_to_string(&mut content)
+        .map_err(CpuInfoError::FileIOError)?;
+    for item in content.split(',') {
+        let item = item.trim();
+        if item.is_empty() {
+            continue;
+        }
+        let cores = item
+            .split('-')
+            .map(str::parse::<u32>)
+            .collect::<Result<Vec<_>, _>>()?;
+        match cores.as_slice() {
+            [core] => {
+                cpus.insert(*core);
+            }
+            [first, last] => cpus.extend(*first..=*last),
+            _ => return Err(CpuInfoError::UnparsableCores(format!("{cores:?}"))),
+        }
+    }
+    Ok(cpus)
+}
+
+pub fn write_cpu_information(
+    process_inspector: &ProcessInspector,
+    sys_info: &mut MDRawSystemInfo,
+) -> Result<(), CpuInfoError> {
+    sys_info.processor_architecture = MDCPUArchitecture::PROCESSOR_ARCHITECTURE_RISCV64 as u16;
+    sys_info.number_of_processors = 0;
+    sys_info.processor_level = 0;
+    sys_info.processor_revision = 0;
+
+    // Match the existing ARM port's present/possible CPU accounting.
+    if let Ok(present) = process_inspector.read_file("/sys/devices/system/cpu/present") {
+        let present = parse_cpus_from_sysfile(present).unwrap_or_default();
+        if let Ok(possible) = process_inspector.read_file("/sys/devices/system/cpu/possible") {
+            let possible = parse_cpus_from_sysfile(possible).unwrap_or_default();
+            sys_info.number_of_processors = present.intersection(&possible).count().min(255) as u8;
+        }
+    }
+    Ok(())
+}
