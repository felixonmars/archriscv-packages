Backport the build-system changes from https://github.com/rocq-prover/rocq/pull/21660

--- a/dune-project
+++ b/dune-project
@@ -1,11 +1,11 @@
-(lang dune 3.8)
+(lang dune 3.21)
 (name rocq-prover)
 
 ; We use directory targets in documentation
 (using directory-targets 0.1)
 
 ; We need this for when we use the dune.disabled files instead of our rule_gen
-(using coq 0.8)
+(using rocq 0.11)
 
 (formatting
  (enabled_for ocaml))
--- a/dune
+++ b/dune
@@ -1,7 +1,7 @@
 ; Default flags for all Rocq libraries.
 (env
  (dev     (flags :standard -w -9-27@60-69@70 \ -short-paths)
-          (coq (flags :standard -w +default)))
+          (rocq (flags :standard -w +default)))
  (release (flags :standard)
           (ocamlopt_flags :standard -O3 -unbox-closures))
  (ireport (flags :standard -w -9-27+60-70)
--- a/theories/Corelib/dune.disabled
+++ b/theories/Corelib/dune.disabled
@@ -1,5 +1,5 @@
 ; For now we use coq_dune to generate the rules here
-(coq.theory
+(rocq.theory
  (name Corelib)
  (package rocq-core)
  (synopsis "Rocq's Core Library")
--- a/theories/Ltac2/dune.disabled
+++ b/theories/Ltac2/dune.disabled
@@ -1,4 +1,4 @@
-(coq.theory
+(rocq.theory
  (name Ltac2)
  (package rocq-core)
  (synopsis "Ltac2 tactic language")
