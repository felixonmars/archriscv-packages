--- PKGBUILD
+++ PKGBUILD
@@ -39,12 +39,15 @@
   # uutils/coreutils is the canonical source for English and
   # French translations, don't overwrite them.
   cp -nr $pkgname-l10n/src/* $pkgname/src/
+  patch -Np1 -d "$pkgname" -i "$srcdir/fix-tests.patch"
 }
 
 check() {
   cd $pkgname
+  # Avoid the du test's process-wide chdir race and timing-test contention.
   make test \
     TEST_NO_FAIL_FAST="-- \
+    --test-threads=1 \
     --skip test_chgrp::test_from_with_invalid_group \
     --skip test_chmod::test_chmod_colored_output \
     --skip test_env::test_env_french \
@@ -88,4 +91,7 @@
   install -Dm 644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
 }
 
+source+=(fix-tests.patch)
+b2sums+=('edf05cfa845d3f2ddec7be3cf6bb1a314edd09c1f106103f027dafb914ee661d4b20cdc9320b576308ede6e96cc6e0e6de962697ffb3d5f6588223aa6386f42c')
+
 # vim: ts=2 sw=2 et:
