     #define REPLACE_NEAR(t, fn, fn_stub) REPLACE_FAR(t, fn, fn_stub)
 #elif defined(__thumb__) || defined(_M_THUMB)
     #error "Thumb is not supported"
+#elif defined(__riscv) && __riscv_xlen == 64
+    #define CODESIZE 24U
