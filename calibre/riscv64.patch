--- PKGBUILD
+++ PKGBUILD
@@ -119,6 +119,9 @@
 
 	# espeak-ng headers do not provide espeak_TextToPhonemesWithTerminator
 	patch -Np1 -i ../tts-piper-remove-withterminator.patch
+
+	# Relax test deadlines that are too short for riscv64 builders.
+	patch -Np1 -i ../relax-slow-test-timeouts.patch
 }
 
 build() {
@@ -138,7 +141,9 @@
 check() {
 	cd "$_archive"
 	export LANG='en_US.UTF-8'
-	python setup.py test --under-sanitize --exclude-test-name test_piper
+	# Hunspell limits suggestions to 100 ms, which expires under parallel load.
+	python setup.py test --under-sanitize --exclude-test-name test_piper --exclude-test-name test_dictionaries
+	python setup.py test --under-sanitize --test-name test_dictionaries
 	python setup.py test_rs
 }
 
@@ -164,3 +169,6 @@
 		python -O -m compileall -d "${_destdir}" "${_file}"
 	done < <(find "$pkgdir/usr/lib/" -name '*.py' -print0)
 }
+
+source+=(relax-slow-test-timeouts.patch)
+sha256sums+=('bbad21a25525c6169f893d4eb407495c13f3668ee884b045f30d2f8f3c232007')
