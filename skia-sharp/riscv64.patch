--- PKGBUILD
+++ PKGBUILD
@@ -46,8 +46,11 @@
   done
 
   pushd externals/skia
+  # The bundled GN and Ninja downloaders do not support riscv64.
+  : > bin/fetch-gn
   python tools/git-sync-deps
-  python bin/fetch-ninja
+  # Header generation invokes GN through this bundled path.
+  ln -sf /usr/bin/gn bin/gn
   popd
 }
 
@@ -69,9 +72,9 @@
     extra_ldflags+="\"${ldflag}\","
   done
 
-  bin/gn gen out \
+  /usr/bin/gn gen out \
     --args="target_os=\"linux\" \
-            target_cpu=\"x64\" \
+            target_cpu=\"riscv64\" \
             cc=\"clang\" \
             cxx=\"clang++\" \
             extra_cflags=[${extra_cflags}] \
@@ -95,7 +98,7 @@
             is_debug=false \
             is_official_build=true \
             linux_soname_version=\"${_minor}.${_patch}.0\""
-  ninja -C out
+  /usr/bin/ninja -C out
 }
 
 package() {
@@ -104,3 +107,5 @@
   ln -s libSkiaSharp.so.${_minor} "${pkgdir}"/usr/lib/libSkiaSharp.so
   install -Dm 644 SkiaSharp/LICENSE.md -t "${pkgdir}"/usr/share/licenses/${pkgname}/
 }
+
+makedepends+=(ninja gn)
