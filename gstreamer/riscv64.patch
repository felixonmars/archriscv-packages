-    'gst-plugin-qsv: qsv plugin'
     'gst-plugin-va: va plugin'
     'gst-plugin-wpe: wpe plugin'
   )
@@ -1335,4 +1343,23 @@
   install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 COPYING LICENSE*
 }
 
