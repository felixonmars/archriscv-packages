+//       1024GB +------------------------------------------------------+
+//              |                         .                            |
+//              |                         .                            |
+//              |                         .                            |
+//              |                         .                            | DRAM_MEM_MAX_SIZE (1022GB)
+//              |                         .                            |
+//              |                         .                            |
+//              |                         .                            |
+//    2MB + 2GB +------------------------------------------------------+ RISCV_KERNEL_START
+//              |                                                      |
+//              |                                                      |
+//              |                                                      |
+//              |                                                      |
+//              |                                                      |
+//          2GB +------------------------------------------------------+ DRAM_MEM_START
+//              |                                                      |
+//              |                                                      |
+//              |                                                      |
+//              |                                                      |
+//              |                                                      |
+//              |                                                      |
+//              |                                                      |
+//              |                                                      |
+//              |                                                      |
+//          1GB +------------------------------------------------------+ MMIO_MEM_START
+//              |                                                      |
+//              |                                                      |
+//              |                                                      |
+//              |                                                      |
+//              |                                                      |
+//              |                                                      |
+//  128MB + 4KB +------------------------------------------------------+ IMSIC_START + IMSIC_SZ_PH
+//              |                                                      |
+//        128MB +------------------------------------------------------+ IMSIC_START
+//              |                                                      |
+//              |                                                      |
+//              |                                                      |
+//              |                                                      |
+//            0 +------------------------------------------------------+ APLIC_START
+
+/// Start of RAM on 64 bit RISCV.
+pub const DRAM_MEM_START: u64 = 0x8000_0000; // 2GB.
+/// The maximum RAM size.
+pub const DRAM_MEM_MAX_SIZE: usize = 0x00FF_8000_0000; // 1024 - 2 = 1022G.
+
+/// Start of system's RAM, which is actually the start of the FDT blob.
+pub const SYSTEM_MEM_START: u64 = DRAM_MEM_START;
+
+/// Size of memory region for FDT placement. The kernel image starts after it,
+/// since the kernel needs to be 2MB-aligned for riscv64.
+pub const SYSTEM_MEM_SIZE: u64 = 0x20_0000; // 2MB.
+
+/// Kernel command line maximum size.
+/// As per `arch/riscv/include/uapi/asm/setup.h`.
+pub const CMDLINE_MAX_SIZE: usize = 1024;
+
+/// Maximum size of the device tree blob.
+pub const FDT_MAX_SIZE: usize = 0x1_0000;
+
+/// Highest wired interrupt, within the minimum IMSIC capacity supported by KVM.
+pub const IRQ_MAX: u32 = kvm_bindings::KVM_DEV_RISCV_AIA_IDS_MIN;
+/// First usable interrupt on riscv64.
+pub const IRQ_BASE: u32 = 1;
+
+/// Below this address will reside the AIA, above this address will reside the MMIO devices.
+pub const MAPPED_IO_START: u64 = 1 << 30; // 1 GB
+
+/// The start of IMSIC(s).
+pub const IMSIC_START: u64 = 0x0800_0000;
+/// IMISC size per hart.
+pub const IMSIC_SZ_PH: u32 = ::kvm_bindings::KVM_DEV_RISCV_IMSIC_SIZE;
+
+/// The start of APLIC.
+pub const APLIC_START: u64 = 0x00;
+
+/// First wired APLIC interrupt source.
+pub const GSI_LEGACY_START: u32 = IRQ_BASE;
+/// Last wired APLIC interrupt source.
+pub const GSI_LEGACY_END: u32 = IRQ_MAX;
+/// Number of allocatable wired interrupts.
+pub const GSI_LEGACY_NUM: u32 = GSI_LEGACY_END - GSI_LEGACY_START + 1;
+/// First GSI reserved for MSI routing.
+pub const GSI_MSI_START: u32 = GSI_LEGACY_END + 1;
+/// Last GSI accepted by KVM's routing table.
+pub const GSI_MSI_END: u32 = 4095;
+/// Number of allocatable MSI routes.
+pub const GSI_MSI_NUM: u32 = GSI_MSI_END - GSI_MSI_START + 1;
+/// Beginning of the low MMIO window.
+pub const MMIO32_MEM_START: u64 = MAPPED_IO_START;
+/// Size of the low MMIO window.
+pub const MMIO32_MEM_SIZE: u64 = DRAM_MEM_START - MMIO32_MEM_START;
+/// Reserved PCI configuration window size.
+pub const PCI_MMCONFIG_SIZE: u64 = 256 << 20;
+/// Beginning of the reserved PCI configuration window.
+pub const PCI_MMCONFIG_START: u64 = DRAM_MEM_START - PCI_MMCONFIG_SIZE;
+/// ECAM aperture for one PCI segment.
+pub const PCI_MMIO_CONFIG_SIZE_PER_SEGMENT: u64 = 4096 * 256;
+/// Boot timer's fixed MMIO address.
+pub const BOOT_DEVICE_MEM_START: u64 = MMIO32_MEM_START;
+/// UART's fixed MMIO address.
+pub const SERIAL_MEM_START: u64 = BOOT_DEVICE_MEM_START + crate::device_manager::mmio::MMIO_LEN;
+/// Beginning of dynamically allocated low MMIO devices.
+pub const MEM_32BIT_DEVICES_START: u64 = SERIAL_MEM_START + crate::device_manager::mmio::MMIO_LEN;
+/// Space available for dynamically allocated low MMIO devices.
+pub const MEM_32BIT_DEVICES_SIZE: u64 = PCI_MMCONFIG_START - MEM_32BIT_DEVICES_START;
+/// High device memory begins beyond the maximum initial DRAM extent.
+pub const MEM_64BIT_DEVICES_START: u64 = 1024 << 30;
+/// Size of the high device memory window.
+pub const MEM_64BIT_DEVICES_SIZE: u64 = 256 << 30;
+/// Beginning of the memory-hotplug window.
+pub const FIRST_ADDR_PAST_64BITS_MMIO: u64 = MEM_64BIT_DEVICES_START + MEM_64BIT_DEVICES_SIZE;
+/// Memory-hotplug space within a 41-bit guest physical address space.
+pub const PAST_64BITS_MMIO_SIZE: u64 = (2048 << 30) - FIRST_ADDR_PAST_64BITS_MMIO;
