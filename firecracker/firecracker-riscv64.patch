+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::test_utils::arch_mem;
+    use crate::test_utils::mock_resources::kernel_image_path;
+
+    #[test]
+    fn memory_layout_keeps_kernel_above_device_tree() {
+        let regions = arch_memory_regions(8 << 20);
+        assert_eq!(
+            regions,
+            vec![(GuestAddress(layout::DRAM_MEM_START), 8 << 20)]
+        );
+        assert_eq!(get_kernel_start() % (2 << 20), 0);
+        assert!(get_fdt_addr() + layout::FDT_MAX_SIZE as u64 <= get_kernel_start());
+    }
+
+    #[test]
+    fn initrd_is_page_aligned_and_inside_ram() {
+        let memory = arch_mem(8 << 20);
+        let address = initrd_load_addr(&memory, 4097).unwrap();
+        assert_eq!(address % crate::arch::GUEST_PAGE_SIZE as u64, 0);
+        assert!(address >= get_kernel_start());
+        assert!(memory.get_slice(GuestAddress(address), 4097).is_ok());
+        assert!(initrd_load_addr(&memory, 8 << 20).is_none());
+    }
+
+    #[test]
+    fn loads_executable_riscv_image() {
+        let memory = arch_mem(8 << 20);
+        let kernel = File::open(kernel_image_path(None)).unwrap();
+        let entry = load_kernel(&kernel, &memory).unwrap();
+        assert_eq!(entry.entry_addr.raw_value(), get_kernel_start());
+        let mut instruction = [0u8; 4];
+        memory
+            .read_slice(&mut instruction, entry.entry_addr)
+            .unwrap();
+        assert_eq!(u32::from_le_bytes(instruction), 0x0400_006f);
+    }
+
+    #[test]
+    fn rejects_image_overlapping_device_tree() {
+        let memory = arch_mem(8 << 20);
+        let mut image = std::fs::read(kernel_image_path(None)).unwrap();
+        image[8..16].fill(0);
+        let kernel = vmm_sys_util::tempfile::TempFile::new().unwrap();
+        std::fs::write(kernel.as_path(), image).unwrap();
+        assert!(matches!(
+            load_kernel(kernel.as_file(), &memory),
+            Err(ConfigurationError::KernelOverlapsFdt)
+        ));
+    }
+}
