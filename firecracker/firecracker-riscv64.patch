+/// Structure representing the current architecture's understand of what a "virtual machine" is.
+#[derive(Debug)]
+pub struct KvmVm {
+    /// Architecture independent parts of a vm.
+    pub common: VmCommon,
+    /// On riscv64 we need to keep around the fd obtained by creating the AIA device.
+    irqchip_handle: Option<crate::arch::riscv64::aia::AIADevice>,
+    pub(crate) irq_events: Mutex<Vec<(EventFd, u32)>>,
+}
+
+/// Error type for [`Vm::restore_state`]
+#[derive(Debug, PartialEq, Eq, thiserror::Error, displaydoc::Display)]
+pub enum KvmVmError {
+    /// Error creating the global interrupt controller: {0}
+    VmCreateAIA(crate::arch::riscv64::aia::AiaError),
+    /// Failed to save the VM's AIA state: {0}
+    SaveAia(crate::arch::riscv64::aia::AiaError),
+    /// Failed to restore the VM's AIA state: {0}
+    RestoreAia(crate::arch::riscv64::aia::AiaError),
+    /// RISC-V snapshots are not supported.
+    SnapshotUnsupported,
+}
+
+impl KvmVm {
+    /// Create a new `Vm` struct.
+    pub fn new(kvm: Kvm) -> Result<KvmVm, VmError> {
+        let common = Self::create_common(kvm)?;
+        Ok(KvmVm {
+            common,
+            irqchip_handle: None,
+            irq_events: Mutex::new(Vec::new()),
+        })
+    }
+
+    /// Pre-vCPU creation setup.
+    pub fn arch_pre_create_vcpus(&mut self, _: u8) -> Result<(), KvmVmError> {
+        Ok(())
+    }
+
+    /// Post-vCPU creation setup.
+    pub fn arch_post_create_vcpus(&mut self, nr_vcpus: u8) -> Result<(), KvmVmError> {
+        self.setup_irqchip(nr_vcpus)
+    }
+
+    /// Creates the AIA (Advanced Interrupt Architecture) IRQchip.
+    pub fn setup_irqchip(&mut self, vcpu_count: u8) -> Result<(), KvmVmError> {
+        self.irqchip_handle = Some(
+            crate::arch::riscv64::aia::AIADevice::create_aia(self.fd(), vcpu_count.into())
+                .map_err(KvmVmError::VmCreateAIA)?,
+        );
+        Ok(())
+    }
+
+    /// Gets a reference to the irqchip of the VM.
+    pub fn get_irqchip(&self) -> &crate::arch::riscv64::aia::AIADevice {
+        self.irqchip_handle.as_ref().expect("IRQ chip not set")
+    }
+
+    pub(crate) fn register_irq_events(
+        &self,
+        ops: &mut EventOps,
+    ) -> Result<(), event_manager::Error> {
+        for (event, _) in self.irq_events.lock().expect("Poisoned lock").iter() {
+            ops.add(Events::new(event, EventSet::IN))?;
+        }
+        Ok(())
+    }
+
+    pub(crate) fn process_irq_event(&self, source: RawFd) -> Option<Result<(), InterruptError>> {
+        let events = self.irq_events.lock().expect("Poisoned lock");
+        let (event, gsi) = events
+            .iter()
+            .find(|(event, _)| event.as_raw_fd() == source)?;
+        Some((|| {
+            event.read()?;
+            self.fd().set_irq_line(*gsi, true)?;
+            self.fd().set_irq_line(*gsi, false)?;
+            Ok(())
+        })())
+    }
+
+    /// Saves and returns the Kvm Vm state.
+    pub fn save_state(&self) -> Result<VmState, KvmVmError> {
+        Err(KvmVmError::SnapshotUnsupported)
+    }
+
+    /// Restore the KVM VM state
+    pub fn restore_state(&mut self, _state: &VmState) -> Result<(), KvmVmError> {
+        Err(KvmVmError::SnapshotUnsupported)
+    }
+}
