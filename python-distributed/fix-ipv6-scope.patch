+def _get_ip_address(sockaddr):
+    """Return an IP address and preserve the scope of link-local IPv6 addresses."""
+    address = socket.getnameinfo(
+        sockaddr, socket.NI_NUMERICHOST | socket.NI_NUMERICSERV
+    )[0]
+    if ":" in address and "%" not in address:
+        if ipaddress.ip_address(address).is_link_local:
+            for interface, addrs in psutil.net_if_addrs().items():
+                if any(
+                    addr.family == socket.AF_INET6
+                    and addr.address.split("%", 1)[0] == address
+                    for addr in addrs
+                ):
+                    return f"{address}%{interface}"
+    return address
