--- PKGBUILD
+++ PKGBUILD
@@ -63,6 +63,28 @@
 source=(https://github.com/dask/distributed/archive/$pkgver/$pkgname-$pkgver.tar.gz)
 b2sums=('63dc79fabdd31a7d33259c558911ee175549071a4c166710bb4efcca68f882bdfe9086bf56db256c81bff47d2e4255ab7efd0306c6a8d10ba01248b9a567113d')
 
+prepare() {
+  cd $_name-$pkgver
+  # Worker metrics contain tuple keys that cannot be serialized as JSON.
+  # https://github.com/dask/distributed/issues/8370
+  patch -Np1 -i "$srcdir/fix-identity-json.patch"
+  # Losing scattered data must also release pending transfer accounting.
+  # https://github.com/dask/distributed/issues/7319
+  patch -Np1 -i "$srcdir/fix-lost-dependency-accounting.patch"
+  # Unpausing must resume dependency transfers as well as computation.
+  # https://github.com/dask/distributed/pull/6462
+  patch -Np1 -i "$srcdir/fix-unpause-deps.patch"
+  # Link-local IPv6 addresses need the interface scope from getaddrinfo().
+  patch -Np1 -i "$srcdir/fix-ipv6-scope.patch"
+  # Cluster tests assume few CPUs and short startup/scheduling latencies.
+  patch -Np1 -i "$srcdir/fix-test-cpu-count.patch"
+  patch -Np1 -i "$srcdir/relax-test-timing.patch"
+  # Cluster scheduling and lease refresh can need additional round trips on riscv64.
+  patch -Np1 -i "$srcdir/fix-test-timing.patch"
+  # A signal handler must not acquire the interrupted Event.wait() lock.
+  patch -Np1 -i "$srcdir/fix-popen-signal.patch"
+}
+
 build() {
   cd $_name-$pkgver
   SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver \
@@ -76,9 +95,8 @@
     -W ignore::DeprecationWarning
     -W ignore::FutureWarning
     -W ignore::UserWarning
-    # distribute tests across multiple CPUs
-    -n auto
-    --dist loadscope
+    # Each test creates its own cluster; avoid contention between clusters.
+    -n 0
     # use 'signal' which only kills the offending test
     --timeout-method signal
     -m "not slow and not leaking and not avoid_ci and not gpu and not extra_packages"
@@ -141,3 +159,20 @@
   python -m installer --destdir="$pkgdir" dist/*.whl
   install -vDm 644 LICENSE.txt -t "$pkgdir"/usr/share/licenses/$pkgname/
 }
+
+source+=(fix-identity-json.patch
