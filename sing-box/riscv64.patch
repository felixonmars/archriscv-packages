--- PKGBUILD
+++ PKGBUILD
@@ -119,12 +119,16 @@
     popd
 
     cd "${srcdir}/${pkgname}-${pkgver}"
+    patch -Np1 -i "${srcdir}/0004-riscv64-test-timeout.patch"
     # https://github.com/SagerNet/sing-box/commit/f5e92e18b272041a8da54d4401d3a6b3cb9b5d50
     patch -Np1 -i "${srcdir}/0005-fix-process-path-of-replaced-executables-on-linux.patch"
     go mod download -modcacherw
 }
 
 build() {
+    # Clang treats -fno-plt as unused on riscv64, which fails runtime/cgo under -Werror.
+    CFLAGS=${CFLAGS/-fno-plt/}
+    CXXFLAGS=${CXXFLAGS/-fno-plt/}
     export CGO_CPPFLAGS="${CPPFLAGS}"
     export CGO_CFLAGS="${CFLAGS}"
     export CGO_CXXFLAGS="${CXXFLAGS}"
@@ -201,3 +205,6 @@
 
     install -Dm644 schema.json -t "${pkgdir}/usr/share/${pkgname}"
 }
+
+source+=("0004-riscv64-test-timeout.patch")
