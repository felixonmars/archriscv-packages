--- PKGBUILD
+++ PKGBUILD
@@ -95,10 +95,14 @@
     popd
 
     cd "${srcdir}/${pkgname}-${pkgver}"
+    patch -Np1 -i "${srcdir}/0004-riscv64-test-timeout.patch"
     go mod download -modcacherw
 }
 
 build() {
+    # Clang treats -fno-plt as unused on riscv64, which fails runtime/cgo under -Werror.
+    CFLAGS=${CFLAGS/-fno-plt/}
+    CXXFLAGS=${CXXFLAGS/-fno-plt/}
     export CGO_CPPFLAGS="${CPPFLAGS}"
     export CGO_CFLAGS="${CFLAGS}"
     export CGO_CXXFLAGS="${CXXFLAGS}"
@@ -173,3 +177,6 @@
 
     install -Dm644 schema.json -t "${pkgdir}/usr/share/${pkgname}"
 }
+
+source+=("0004-riscv64-test-timeout.patch")
+sha256sums+=('261ee4207f85eb11d7352fc035186e5955ad3e28b8a41e0729463cc88c98ba3f')
