--- PKGBUILD
+++ PKGBUILD
@@ -70,6 +70,8 @@
 
 prepare() {
   cd apache-$pkgname-$pkgver
+  # https://github.com/apache/arrow/pull/55744
+  patch -Np1 -i "$srcdir/arrow-quantile-precision.patch"
   # Patch out unused AWS-SDK component https://github.com/apache/arrow/pull/45191
   sed -i 's|COMPONENTS config|COMPONENTS|' cpp/cmake_modules/FindAWSSDKAlt.cmake
 }
@@ -136,7 +138,7 @@
     # execute tests in parallel
     --parallel $(nproc)
     # limit execution time for each test
-    --timeout 200
+    --timeout 600
     # exclude problematic tests
     --exclude-regex "$excluded_tests"
   )
@@ -150,3 +152,6 @@
   # remove testing libraries
   find "$pkgdir"/usr/lib/ -name '*testing*' -delete
 }
+
+source+=("arrow-quantile-precision.patch::https://github.com/apache/arrow/commit/391be251d3f1365fdbacfde6112330fb80143510.patch")
