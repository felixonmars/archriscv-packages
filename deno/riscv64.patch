--- PKGBUILD
+++ PKGBUILD
@@ -22,17 +22,24 @@
 
 prepare() {
+  # Fix incomplete libuv bindings with Clang 22: https://github.com/rust-lang/rust-bindgen/pull/3278
+  sed -i 's/0\.70\.1/0.72.1/' libuv-sys-lite-1.48.4/Cargo.toml
+
   cd rusty_v8
   git config -f .gitmodules submodule.v8.shallow true
   git submodule update --init --recursive
 
+  # Allow WASM trap branches beyond JAL's 1 MiB range.
+  sed -i 's/__ b(zone()->New<OutOfLineTrap>/__ Branch(zone()->New<OutOfLineTrap>/' v8/src/compiler/backend/riscv/code-generator-riscv.cc
+
+  # Native riscv64 builds do not need Chromium's Debian sysroots.
+  sed -i '/if target_arch == "riscv64"/,/^  }$/ s/if target_os == "linux" {/if target_os == "linux" \&\& env::var("TARGET") != env::var("HOST") {/' build.rs
+
   # Use system-provided Rust toolchain for V8 build
   sed -i '/download_rust_toolchain();/d' build.rs
   patch -Np1 -i ../deno-2.9.6-rust-system.patch
 
-  # https://github.com/denoland/rusty_v8/issues/1587
-  patch -Np1 -i ../compiler-rt-adjust-paths.patch
-
   cd ../deno
   echo -e "\n[patch.crates-io]\nv8 = { path = '../rusty_v8' }" >> Cargo.toml
+  echo "libuv-sys-lite = { path = '../libuv-sys-lite-1.48.4' }" >> Cargo.toml
   # Keep the V8 backend while disabling Deno's self-upgrade and vendored zlib-ng.
   sed -i \
@@ -98,2 +105,5 @@
   install -Dm644 LICENSE.md -t "$pkgdir"/usr/share/licenses/$pkgname/
 }
