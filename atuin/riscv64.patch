--- PKGBUILD
+++ PKGBUILD
@@ -33,6 +33,11 @@
 prepare() {
 	_srcenv
 
+	# Honor the test timeout override in metadata-store tests too.
+	patch -Np1 -i "$srcdir/meta-test-timeout.patch"
+	# Concurrent imports can reuse an export filename before cleanup is checked.
+	patch -Np1 -i "$srcdir/opencode-export-tempfile.patch"
+
 	# Fully lock down user
 	sed -i 's/^u /u! /' systemd/atuin-server.sysusers
 
@@ -50,6 +55,8 @@
 
 check() {
 	_srcenv
+	# SQLite pool setup can exceed upstream's 2s test default on slower builders.
+	export ATUIN_TEST_LOCAL_TIMEOUT=30.0
 	local skipped=(
 		# Assumes things about the host that aren't true in a chroot
 		ai_session::store::tests::reproject_takes_the_capture_lock_for_this_hosts_records
@@ -87,3 +94,8 @@
 	install -Dm0644 -t "$pkgdir/usr/share/doc/$pkgname/" README.md "crates/$pkgname/server.toml"
 	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
 }
+
+checkdepends+=(fish zsh)
+source+=(meta-test-timeout.patch opencode-export-tempfile.patch)
+sha256sums+=('266cbf0e8a37ec2053e5d8f9dd64dd220fb09044070e37bd05a7e8be9ac99924'
+            '741671d10b5cb88d3ff44125785152899d15ef8ff85eb3120525df3cb7050b6e')
