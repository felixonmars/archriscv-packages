--- PKGBUILD
+++ PKGBUILD
@@ -23,6 +23,8 @@
 
 prepare() {
   cd "$pkgname-$pkgver"
+  patch -Np1 -i "$srcdir/round-tokenized-ranking-score.patch"
+  patch -Np1 -i "$srcdir/test-task-timeout.patch"
   cargo fetch --locked --target host-tuple
 }
 
@@ -37,7 +39,8 @@
   cd "$pkgname-$pkgver"
   ulimit -n 8192
   export ZSTD_SYS_USE_PKG_CONFIG=1
-  cargo test --release --locked --package meilisearch
+  cargo nextest run --release --locked --package meilisearch --test-threads=2
+  cargo test --release --locked --package meilisearch --doc -- --test-threads=2
 }
 
 package() {
@@ -50,3 +53,8 @@
   install -D -m644 "${srcdir}/meilisearch.tmpfiles" "${pkgdir}/usr/lib/tmpfiles.d/meilisearch.conf"
   install -D -m644 "${srcdir}/meilisearch.conf" "${pkgdir}/etc/meilisearch.conf"
 }
