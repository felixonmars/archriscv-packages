--- PKGBUILD
+++ PKGBUILD
@@ -8,8 +8,10 @@
 pkgname=pycharm-community-edition
 pkgver=2026.2.3
 _build=262.10968.92
-_jrever=21
+_jrever=25
 _jdkver=21
+_skikover=0.150.1
+_skiaver=m150-1f14f1166a
 pkgrel=1
 pkgdesc='Python IDE for Professional Developers'
 arch=(x86_64)
@@ -44,26 +46,46 @@
             '0dbec010e5c5412ba1f1fd8fc07fcfe373ad174cd54537d125643ef5ef51c8f7')
 
 prepare() {
-  cd intellij-community
-
-  sed -e "s/buildNumber = null/buildNumber = \"${_build}\"/" \
-      -i "python/build/src/PyCharmCommunityInstallersBuildTarget.kt"
-  mv "${srcdir}"/idea-android android
-
-  sed -e 's/System.getProperty(TARGET_OS_PROPERTY, OS_ALL)/OS_LINUX/' \
-      -i "platform/build-scripts/src/org/jetbrains/intellij/build/BuildOptions.kt"
+  patch -d JetBrains-IDE-Multiarch -Np1 < multiarch-riscv64.patch
+  patch -d skiko -Np1 < skiko-riscv64.patch
+  patch -d skia-${_skiaver} -Np1 < skia-riscv64.patch
+
+  cd JetBrains-IDE-Multiarch
+
+  sed -i '/^natives\.linux\.riscv64\.url=/d' config/natives.properties
+  sed -i "s/^pc.version=.*/pc.version=${pkgver}/" config/product.properties
+  mkdir -p build/download/ide
+  ln -sf "${srcdir}/pycharm-${pkgver}-aarch64.tar.gz" \
+    "build/download/ide/pycharm-community-${pkgver}-aarch64.tar.gz"
 }
 
 build() {
-  cd intellij-community
-
   export JAVA_HOME="/usr/lib/jvm/java-${_jdkver}-openjdk"
   export PATH="/usr/lib/jvm/java-${_jdkver}-openjdk/bin:$PATH"
-  export MAVEN_REPOSITORY=/build/.m2/repository
 
-  ./python/installers.cmd -Dintellij.build.use.compiled.classes=false -Dintellij.build.target.os=linux -Dintellij.build.target.arch=x64 -Dbuild.number="${_build}"
-
-  tar -xf out/pycharm-ce/artifacts/pycharmPC-${_build}.tar.gz -C "${srcdir}"
+  cd skia-${_skiaver}
+  GIT_SYNC_DEPS_SKIP_EMSDK=1 python tools/skia_release/build.py \
+    --skia-dir . --target linux --machine riscv64 --gpu-as-extension
+
+  cd "${srcdir}/skiko"
+  ./gradlew -p skiko awtJar skikoJvmRuntimeJarLinuxRiscv64 \
+    -Pskia.dir="${srcdir}/skia-${_skiaver}" \
+    -Pdeploy.version="${_skikover}" -Pdeploy.release=true
+
+  cd "${srcdir}/JetBrains-IDE-Multiarch"
+  ./gradlew transformPC-riscv64 -x downloadPC -Pjdk.linux.riscv64.url=
+  tar -xf build/target/pycharm-community-${pkgver}+0-riscv64.tar.gz -C "${srcdir}"
+
+  mkdir -p "${srcdir}/skiko-classes"
+  cd "${srcdir}/skiko-classes"
+  bsdtar -xf "${srcdir}/skiko/skiko/build/libs/skiko-awt-${_skikover}.jar" \
+    'org/jetbrains/skiko/Arch*.class' 'org/jetbrains/skiko/OsArch_jvmKt*.class'
+  jar uf "${srcdir}/pycharm-oss/lib/intellij.libraries.skiko.jar" org
+
+  cd "${srcdir}/pycharm-oss/lib/skiko-awt-runtime-all"
+  rm libskiko-linux-arm64.so
+  bsdtar -xf "${srcdir}/skiko/skiko/build/libs/skiko-${_skikover}-linux-riscv64.jar" \
+    libskiko-linux-riscv64.so
 }
 
 package() {
@@ -73,7 +95,8 @@
   sed -i 's/lcd/on/' bin/*.vmoptions
 
   install -dm 755 "${pkgdir}"/usr/share/{licenses,pycharm,icons/hicolor/{128x128,scalable}/apps}
-  cp -dr --no-preserve='ownership' bin lib plugins jbr "${pkgdir}"/usr/share/pycharm/
+  cp -dr --no-preserve='ownership' bin lib plugins modules "${pkgdir}"/usr/share/pycharm/
+  ln -s /usr/lib/jvm/java-${_jrever}-openjdk "${pkgdir}"/usr/share/pycharm/jbr
   cp -dr --no-preserve='ownership' license "${pkgdir}"/usr/share/licenses/pycharm/
   ln -s /usr/share/pycharm/bin/pycharm.png "${pkgdir}"/usr/share/icons/hicolor/128x128/apps/
   ln -s /usr/share/pycharm/bin/pycharm.svg "${pkgdir}"/usr/share/icons/hicolor/scalable/apps/
@@ -82,4 +105,24 @@
   install -Dm 644 product-info.json -t "${pkgdir}"/usr/share/pycharm
 }
 
