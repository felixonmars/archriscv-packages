--- PKGBUILD
+++ PKGBUILD
@@ -71,6 +71,10 @@
 
 prepare() {
   cp -r $pkgbase{,-src}
+  # Avoid logging SSL_write() failures after a failed read with OpenSSL 4.
+  patch -p1 -d nginx -i "$srcdir/nginx-ssl-write-after-failed-read.patch"
+  patch -p1 -d nginx-tests -i "$srcdir/h3_limit_req-fix-spurious-failures.patch"
+  patch -p1 -d nginx-tests -i "$srcdir/proxy_h2_pass_request-fix-short-reads.patch"
   # Fix ssl_certificate_compression test: loop only checked first algorithm
   sed '/\$has_zlib = 1 if \$algo == 1;/{n;/^\t\t\t\tlast;/d}' -i nginx-tests/ssl_certificate_compression.t
 
@@ -198,7 +200,8 @@
 check() {
   cd nginx-tests
   local _jobs=$(nproc)
-  (( _jobs > 16 )) && _jobs=16
+  # Keep HTTP/2 tests from hitting fixed 8-second socket timeouts under load.
+  (( _jobs > 8 )) && _jobs=8
   TEST_NGINX_BINARY="$srcdir/$pkgbase/objs/nginx" prove -j "$_jobs" .
 }
 
@@ -324,3 +329,10 @@
   backup=(etc/nginx/modules.d/20-xslt.conf)
   _package_module xslt
 }
+
+source+=('h3_limit_req-fix-spurious-failures.patch::https://freenginx.org/hg/nginx-tests/raw-rev/1867428f1673214f6e2bb647a2bba0ae3a77bcb7'
+         'proxy_h2_pass_request-fix-short-reads.patch'
+         'nginx-ssl-write-after-failed-read.patch::https://github.com/nginx/nginx/commit/1967e2bdc468df2f91a20d5523719688a1287611.patch')
+sha512sums+=('968876b01bee3c7cea816958ebaf8241f4d030aa0071552aed2e22ea615ef6e3ae8b06b4af4d780a8fbb93c9422b629fdbaaf21d0822ee40960bcfb56c6e8054'
+             '08823899c833aa0ccb26a129ea7a276ee821ba6d125541a5e03512dc7acf550f64dedcdf973794739f2a633a6828bea3d98b158c7ed634365b72f344ca237d0e'
+             'a2b664c23144ba617ddc96181bdd9b71d31c5930313aa2f47db0ef6d6f5fe8de252576ddd2026499c2ca2420739307a7a955076ec9d4e9f5f3ea69aa65474dda')
