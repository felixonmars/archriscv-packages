--- PKGBUILD
+++ PKGBUILD
@@ -14,6 +14,7 @@
 prepare() {
   cd "$pkgname-$pkgver"
 
+  patch -Np1 -i "$srcdir/dos-tests.patch"
   cargo fetch --locked --target host-tuple
 }
 
@@ -23,11 +24,12 @@
   cargo build --release --frozen --features c-api
 }
 
-# check() {
-#   cd "$pkgname-$pkgver"
-#
-#   cargo test --frozen --features c-api
-# }
+check() {
+  cd "$pkgname-$pkgver"
+
+  # Keep the DoS tests optimized and serial on RISC-V.
+  cargo test --release --frozen --features c-api -- --test-threads=1
+}
 
 package() {
   cd "$pkgname-$pkgver"
@@ -36,3 +38,6 @@
   install -Dm644 -t "$pkgdir/usr/include" include/tlottie.h
   install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
 }
+
+source+=('dos-tests.patch')
