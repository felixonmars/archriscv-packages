+  printf '{}\n' > node_modules/@typescript/native-preview-linux-riscv64/package.json
+
+  cd packages/svelte2tsx
   pnpm build
   cd ../language-server
   pnpm build
@@ -38,7 +47,7 @@
 
 check() {
   cd $_name/packages/language-server
-  pnpm run test --no-experimental-strip-types
+  pnpm run test --no-experimental-strip-types --timeout 1000000
 }
 
