--- PKGBUILD
+++ PKGBUILD
@@ -27,10 +27,19 @@
 prepare() {
   cd $_name
   pnpm install --frozen-lockfile
+  GOPATH="$srcdir" go -C "$srcdir/typescript-go" mod download -modcacherw
 }
 
 build() {
-  cd $_name/packages/svelte2tsx
+  cd typescript-go
