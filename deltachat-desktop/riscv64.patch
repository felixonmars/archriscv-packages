--- PKGBUILD
+++ PKGBUILD
@@ -70,6 +70,8 @@
   done
 
   pnpm install --frozen-lockfile
+  patch -d node_modules/.pnpm/builder-util@26.15.3_supports-color@8.1.1/node_modules/builder-util -Np0 -i "$srcdir/builder-util-riscv64.patch"
+  patch -Np1 -i "$srcdir/deltachat-desktop-system-rpc.patch"
 }
 
 build() {
@@ -83,9 +85,10 @@
 
   cd $pkgname
   export NODE_ENV=production
-  pnpm --filter=$filter pack:asar
-  # Remove the prebuilt deltachat-rpc-server, as we are using a packaged one.
-  rm -v packages/target-electron/dist/linux-unpacked/resources/app.asar.unpacked/node_modules/@deltachat/stdio-rpc-server-linux-x64/deltachat-rpc-server
+  pnpm --filter=$filter pack:generate_config
+  pnpm --filter=$filter build4production
+  pnpm --filter=$filter run pack:patch-node-modules
+  pnpm --filter=$filter exec electron-builder ${electron_builder_options[@]}
 }
 
 package() {
@@ -104,7 +107,7 @@
 
   cd $pkgname
   install -vdm 755 "$pkgdir/usr/lib/$pkgname/"
-  cp -rv packages/target-electron/dist/linux-unpacked/resources/* "$pkgdir/usr/lib/$pkgname/"
+  cp -rv packages/target-electron/dist/linux-riscv64-unpacked/resources/* "$pkgdir/usr/lib/$pkgname/"
 
   # icons
   install -vDm 644 images/tray/${pkgname/-desktop/}.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"
@@ -118,3 +121,10 @@
 
   install -vDm 644 {CHANGELOG,CONTRIBUTING,README,SECURITY}.md -t "$pkgdir/usr/share/doc/$pkgname/"
 }
