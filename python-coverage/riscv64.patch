--- PKGBUILD
+++ PKGBUILD
@@ -18,6 +18,7 @@
 
 prepare() {
   cd $_pkgname
+  patch -Np1 -i "$srcdir/multiprocessing-workers.patch"
   # Pytest 9.2 requires an integer for assertion verbosity in native TOML config.
   sed -i 's/^verbosity_assertions = "5"$/verbosity_assertions = 5/' pyproject.toml
 }
@@ -29,6 +30,8 @@
 
 check() {
   cd $_pkgname
+  # Slow input generation trips Hypothesis's health check on riscv64.
+  sed -i 's/settings(deadline=400)/settings(deadline=400, suppress_health_check=["too_slow"])/' tests/test_numbits.py
   python -m venv --system-site-packages test-env
   test-env/bin/python -m installer dist/*.whl
   test-env/bin/python setup.py --quiet build_ext --inplace
@@ -40,3 +43,7 @@
   cd $_pkgname
   python -m installer --destdir="$pkgdir" dist/*.whl
 }
+
+source+=(multiprocessing-workers.patch)
