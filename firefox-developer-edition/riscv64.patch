--- PKGBUILD
+++ PKGBUILD
@@ -114,6 +114,12 @@
   # Make different channels installable in parallel
   patch -Np1 -i ../0001-Install-under-remoting-name.patch
 
+  # Clang 20+ exposes RVV intrinsics even when the target has no vector extension.
+  # https://github.com/ggml-org/llama.cpp/issues/22159
+  patch -Np1 -i ../llama-rvv-feature-detection.patch
+
+  patch -Np1 -i ../wasm2c-riscv64-simd-force-read.patch
+
   # Don't let the branding override our remoting name
   sed '/^MOZ_APP_REMOTINGNAME=/d' -i browser/branding/aurora/configure.sh
 
@@ -155,10 +161,18 @@
 # Features
 ac_add_options --enable-alsa
 ac_add_options --enable-jack
-ac_add_options --enable-crashreporter
 ac_add_options --disable-updater
 ac_add_options --disable-tests
 END
+
+  case "$CARCH" in
+    x86_64 | i*86 | arm* | aarch64)
+      echo 'ac_add_options --enable-crashreporter' >>../mozconfig
+      ;;
+    *)
+      echo 'ac_add_options --disable-crashreporter' >>../mozconfig
+      ;;
+  esac
 }
 
 build() {
@@ -293,3 +307,9 @@
 }
 
