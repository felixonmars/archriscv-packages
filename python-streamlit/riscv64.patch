--- PKGBUILD
+++ PKGBUILD
@@ -82,2 +82,7 @@
 prepare() {
+  patch -d "$srcdir/$_name" -Np1 -i "$srcdir/test-timing.patch"
+  cd "$srcdir"/rolldown-1.2.14
+  cargo fetch --locked --target riscv64gc-unknown-linux-gnu
+  cd "$srcdir"
+
   cd $_name
@@ -89,2 +94,7 @@
 build() {
+  cd "$srcdir"/rolldown-1.2.14
+  CFLAGS="$CFLAGS -ffat-lto-objects" \
+    cargo build --frozen --release -p rolldown_binding --target riscv64gc-unknown-linux-gnu
+  cd "$srcdir"
+
   # initialize corepack
@@ -98,3 +108,14 @@
   cd "$srcdir"/$_name/frontend
-  yarn install --immutable
+  sed -i \
+    -e 's|"@vitejs/plugin-react-swc": "[^"]*"|"@vitejs/plugin-react": "5.2.0"|' \
+    -e 's|"@swc/plugin-emotion": "[^"]*"|"@emotion/babel-plugin": "11.13.5"|' \
+    {app,lib}/package.json
+  sed -i \
+    -e 's|@vitejs/plugin-react-swc|@vitejs/plugin-react|' \
+    -e 's|plugins: \[\["@swc/plugin-emotion", {}\]\]|babel: { plugins: ["@emotion/babel-plugin"] }|' \
+    {app,lib}/vite.config.ts
+  sed -i '/"resolutions": {/a\    "lightningcss": "npm:lightningcss-wasm@1.33.0",' package.json
+  yarn remove @bufbuild/buf
+  install -m755 "$srcdir"/rolldown-1.2.14/target/riscv64gc-unknown-linux-gnu/release/librolldown_binding.so \
+    node_modules/rolldown/dist/shared/rolldown-binding.linux-riscv64-gnu.node
 
@@ -162,2 +183,7 @@
   cd $_name/lib
+  # Discovery probes need longer on slow builders. Only change the test source:
+  # the wheel was already built with the upstream timeouts.
+  sed -i -e 's/^_PROBE_TIMEOUT_S = 5$/_PROBE_TIMEOUT_S = 60/' \
+         -e 's/^_TOTAL_TIMEOUT_S = 7$/_TOTAL_TIMEOUT_S = 90/' \
+    streamlit/.agents/meta-skill/developing-with-streamlit/scripts/discover.py
   python -m venv --system-site-packages test-env
@@ -173 +199,7 @@
 }
