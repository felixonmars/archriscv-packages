   CFLAGS+=" -std=gnu17" \
+  CXXFLAGS+=" $(pkg-config --cflags cairo)" \
   cmake .. \
     -DCMAKE_INSTALL_PREFIX=/usr \
     -DCMAKE_BUILD_TYPE=Release \
