--- PKGBUILD
+++ PKGBUILD
@@ -32,6 +32,8 @@
 prepare() {
   cd "${pkgname}"
 
+  # The pinned pnpm release has no riscv64 native binary.
+  printf '\npmOnFail: ignore\n' >> pnpm-workspace.yaml
   pnpm i --frozen-lockfile
 }
 
@@ -65,8 +67,8 @@
   install -Dm644 "${srcdir}/sysusers.conf" "${pkgdir}/usr/lib/sysusers.d/${pkgname}.conf"
   install -Dm644 "${srcdir}/tmpfiles.conf" "${pkgdir}/usr/lib/tmpfiles.d/${pkgname}.conf"
 
-  # Cleanups x86_64 specific
-  if [ "${CARCH}" = "x86_64" ]; then
+  # Cleanups riscv64 specific
+  if [ "${CARCH}" = "riscv64" ]; then
     local find_dirs=(
     -iwholename '*.github' -o
     -iwholename '*.idea' -o
@@ -81,6 +83,7 @@
     -iwholename '*/linux-armvy' -o
     -iwholename '*/linux-armv7' -o
     -iwholename '*/linux-arm' -o
+    -iwholename '*/linux-x64' -o
     -iwholename '*/win32-ia32' -o
     -iwholename '*/win32-x64' -o
     -iwholename '*/darwin-x64'
@@ -90,3 +93,5 @@
   fi
 
 }
+
+makedepends+=('node-gyp' 'python')
