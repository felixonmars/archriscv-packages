--- PKGBUILD
+++ PKGBUILD
@@ -35,7 +35,24 @@
   fi
 
   cd $pkgname/${pkgname}11/$pkgname
-  pnpm install --frozen-lockfile
+  rm -r artifacts
+
+  # Clone read-only timeout errors before redacting registry credentials.
+  # https://github.com/pnpm/pnpm/pull/12519
+  sed -i '/^  if (isError(error)) {/a\
+    error = Object.assign(new Error(), error, {\
+      name: error.name, message: error.message, stack: error.stack, cause: error.cause,\
+      ...("code" in error ? { code: error.code } : {}),\
+    })' ../resolving/npm-resolver/src/fetch.ts
+
+  # Use installed pnpm and Node.js; upstream native binaries lack riscv64.
+  sed -i -e '/^  "packageManager":/d' \
+    -e '/^    "packageManager": {/,/^    },/d' \
+    -e '/"runtime": {/,/^    }/s/"download"/"ignore"/' ../../package.json
+  # Bootstrap pnpm 11 only understands per-task concurrency and dependencies.
+  sed -i 's/^    concurrencyGroup: .*/    concurrency: 1/; /^    priority:/d' ../../pnpm-workspace.yaml
+  sed -i 's/tsgo --build/tsc --build/; s/pnx node@runtime:24.6.0/node/' package.json
+  pnpm install --no-frozen-lockfile
 
 }
 
