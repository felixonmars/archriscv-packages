+@pytest.mark.parametrize(
+    "version, interface_version",
+    [("9.0.2", "9002"), ("9.10.1", "9101"), ("9.6.7.20250817", "906720250817")],
+)
+def test_snapshot_version(version, interface_version, monkeypatch, tmp_path):
+    monkeypatch.delattr(HiFile, "hi_version", raising=False)
+    monkeypatch.setattr(
+        "diffoscope.comparators.haskell.our_check_output",
+        lambda cmd: (version + "\n").encode(),
+    )
+    path = tmp_path / "snapshot.hi"
+    path.write_bytes(
+        HI_MAGIC + bytes([len(interface_version)]) + interface_version.encode()
+    )
+    try:
+        assert HiFile.recognizes(FilesystemFile(str(path)))
+        assert HiFile.hi_version == interface_version
+    finally:
+        del HiFile.hi_version
