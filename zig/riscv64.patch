--- PKGBUILD
+++ PKGBUILD
@@ -21,6 +21,7 @@
     cd "$pkgname-$pkgver"
 
     patch -p1 -i ../skip-futex2-test.patch
+    patch -p1 -i ../maker-job-limit.patch
 }
 
 build() {
@@ -37,7 +38,8 @@
         ZIG_SHARED_LLVM=ON
         ZIG_USE_LLVM_CONFIG=ON
 
-        ZIG_TARGET_TRIPLE=native-linux.6.12-gnu.2.40
+        # Native builders such as aurorus still run Linux 6.6.
+        ZIG_TARGET_TRIPLE=native-linux.6.6-gnu.2.40
         ZIG_TARGET_MCPU=baseline
     )
     cmake -B build "${cmake_vars[@]/#/-D}" .
@@ -47,7 +49,9 @@
 check() {
     cd "$pkgname-$pkgver"
 
-    ./build/stage3/bin/zig build test \
+    # Concurrent compilers deadlock on shared runtime cache manifests.
+    # https://codeberg.org/ziglang/zig/issues/37474
+    ./build/stage3/bin/zig build test -j1 \
       -Dconfig_h=build/config.h \
       -Dversion-string="$pkgver" \
       -Dstatic-llvm=false \
@@ -66,3 +70,6 @@
     mkdir -p "$pkgdir/usr/share/doc/"
     mv "$pkgdir/usr/doc" "$pkgdir/usr/share/doc/zig"
 }
+
+source+=(maker-job-limit.patch)
+sha256sums+=('cfef880a54564811cead8df4731199834f131f084293b0a20a4cef29e80b9b99')
