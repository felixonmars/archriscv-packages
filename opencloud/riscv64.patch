--- PKGBUILD
+++ PKGBUILD
@@ -42,6 +42,14 @@
 
   # ensure reproducible strings
   patch -p1 -i "$srcdir/version-strings.patch"
+
+  # Mockery 3.8.1 supports Go 1.27.2+ export data.
+  sed -i 's/v3\.7\.4/v3.8.1/g' .bingo/{mockery.mod,Variables.mk,variables.env}
+
+  # The pinned pnpm release has no riscv64 native binary.
+  printf '\npmOnFail: ignore\n' >> services/idp/pnpm-workspace.yaml
+  # Include native optional dependencies for the build host's CPU.
+  sed -i '/^  cpu:/a\    - current' services/idp/pnpm-workspace.yaml
 }
 
 build() {
@@ -81,3 +89,6 @@
   install -vDm644 fish.completion "$pkgdir/usr/share/fish/vendor_completions.d/opencloud.fish"
   install -vDm644 zsh.completion "$pkgdir/usr/share/zsh/site-functions/_opencloud"
 }
+
+# The IDP build invokes node directly; standalone pnpm does not provide it.
+makedepends+=(nodejs)
