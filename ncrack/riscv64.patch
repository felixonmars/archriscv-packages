--- PKGBUILD
+++ PKGBUILD
@@ -20,6 +20,9 @@
 prepare() {
   cd ${pkgname}-${pkgver}
   patch -Np1 -i ../ncrack-nullcheck.patch
+  patch -Np1 -i ../ncrack-config-scripts.patch
+  # The bundled SSH library has its own outdated config scripts.
+  cp config.{guess,sub} opensshlib/
 }
 
 build() {
@@ -27,6 +30,7 @@
   CFLAGS+=' -Wno-int-conversion -Wno-implicit-function-declaration -fcommon' # https://wiki.gentoo.org/wiki/Gcc_10_porting_notes/fno_common
   ./configure \
     --prefix=/usr \
+    --without-zlib-version-check \
     --without-openssl-header-check
   make
 }
@@ -38,3 +42,7 @@
 }
 
