--- PKGBUILD
+++ PKGBUILD
@@ -41,19 +41,43 @@
 	sed -i "s/1.0.0-local/$pkgver/" "apps/app-frontend/package.json"
 	sed -i "s/1.0.0-local/$pkgver/" "Cargo.lock"
 
+	node <<'EOF'
+const fs = require('node:fs');
+const manifest = JSON.parse(fs.readFileSync('package.json', 'utf8'));
+manifest.pnpm.onlyBuiltDependencies = manifest.pnpm.onlyBuiltDependencies.filter(
+	dependency => !['@sentry/cli', 'workerd'].includes(dependency));
+fs.writeFileSync('package.json', JSON.stringify(manifest, null, '\t') + '\n');
+EOF
+	sed -i 's|pnpm turbo run build --filter=@modrinth/app-frontend|pnpm -w i18n:coverage \&\& pnpm -r --filter=@modrinth/app-frontend... run build|' apps/app/tauri.conf.json
+
 	# needed to find node-gyp
 	export NODE_PATH='/usr/lib/node_modules'
 	export TURBO_TELEMETRY_DISABLED=1
-	pnpm install --frozen-lockfile
+	pnpm --filter=@modrinth/app... --filter=@modrinth/monorepo install --frozen-lockfile
 
 	cp -f "packages/app-lib/.env.prod" "packages/app-lib/.env"
 
 	cd apps/app
 	cargo fetch --locked --target host-tuple
+
+	cd "$srcdir/rolldown-1.0.0-rc.12"
+	cargo fetch --locked --target riscv64gc-unknown-linux-gnu
+	cd "$srcdir/lightningcss-1.32.0"
+	cargo fetch --locked --manifest-path node/Cargo.toml --target riscv64gc-unknown-linux-gnu
 }
 
 build() {
-	cd $pkgname/apps/app
+	cd "$srcdir/rolldown-1.0.0-rc.12"
+	cargo build --frozen --release -p rolldown_binding --target riscv64gc-unknown-linux-gnu
+	install -m755 target/riscv64gc-unknown-linux-gnu/release/librolldown_binding.so \
+		"$srcdir/$pkgname/node_modules/.pnpm/rolldown@1.0.0-rc.12/node_modules/rolldown/dist/shared/rolldown-binding.linux-riscv64-gnu.node"
+
+	cd "$srcdir/lightningcss-1.32.0"
+	cargo build --frozen --release --manifest-path node/Cargo.toml --target riscv64gc-unknown-linux-gnu
+	install -m755 target/riscv64gc-unknown-linux-gnu/release/liblightningcss_node.so \
+		"$srcdir/$pkgname/node_modules/.pnpm/lightningcss@1.32.0/node_modules/lightningcss/lightningcss.linux-riscv64-gnu.node"
+
+	cd "$srcdir/$pkgname/apps/app"
 
 	export NODE_PATH='/usr/lib/node_modules'
 	export TURBO_TELEMETRY_DISABLED=1
@@ -70,3 +94,10 @@
 	install -Dm644 apps/app/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/modrinth-app.png"
 	install -Dm644 apps/app/icons/icon.png "$pkgdir/usr/share/icons/hicolor/256x256@2/apps/modrinth-app.png"
 }
+
+makedepends=("${makedepends[@]/java-environment>=17/jdk17-openjdk}")
+makedepends+=(cmake)
+source+=("rolldown-1.0.0-rc.12.tar.gz::https://github.com/rolldown/rolldown/archive/refs/tags/v1.0.0-rc.12.tar.gz"
+	"lightningcss-1.32.0.tar.gz::https://github.com/parcel-bundler/lightningcss/archive/refs/tags/v1.32.0.tar.gz")
+sha256sums+=('7d5884aec0ced4d994f1a34a6e831a46373b97dd15f7f074f68c04a1fda0450c'
+	'ca67b9ba532d439f5f91d23debfc2543d6decac130ee88bc4c66202fc7173ad9')
