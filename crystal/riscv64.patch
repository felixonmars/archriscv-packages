--- PKGBUILD
+++ PKGBUILD
@@ -44,6 +44,12 @@
 
 prepare() {
   cd "${pkgbase}-${pkgver}"
+
+  if [[ $CARCH == riscv64 ]]; then
+    patch -Np1 -i ../crystal-riscv64.patch
+    ln -s ../../linux src/lib_c/riscv64-linux-gnu/c/linux
+    cp src/lib_c/aarch64-linux-gnu/c/semaphore.cr src/lib_c/riscv64-linux-gnu/c/semaphore.cr
+  fi
 }
 
 build() {
@@ -108,3 +114,10 @@
   # remove source asciidoc files, we already have rendered man pages
   rm -rf "${pkgdir}/usr/share/doc/crystal/api/doc/man"
 }
+
+source_riscv64=(
+  'crystal-riscv64.patch'
+)
+sha256sums_riscv64=(
+  '05ead4c8e5c72e06d4e4c9197e8b93ae05896a98857cb2d67e488453b51b09e1'
+)
