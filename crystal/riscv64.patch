 prepare() {
   cd "${pkgbase}-${pkgver}"
+
+  if [[ $CARCH == riscv64 ]]; then
+    patch -Np1 -i ../crystal-riscv64.patch
+    ln -s ../../linux src/lib_c/riscv64-linux-gnu/c/linux
+
+    # Constant initialization must also support the execution-context monitor's bare thread.
+    patch -Np1 -i ../crystal-thread-wait.patch
+    patch -Np1 -i ../crystal-once-bare-threads.patch
+    patch -Np1 -i ../crystal-thread-wait-eintr.patch
+    cp src/lib_c/aarch64-linux-gnu/c/semaphore.cr src/lib_c/riscv64-linux-gnu/c/semaphore.cr
+    chmod +x "$srcdir/crystal-x86_64-cc"
+
+    mkdir -p "$srcdir/crystal-bootstrap" "$srcdir/crystal-x86-runtime"
+    bsdtar --no-same-owner -xf "$srcdir/crystal-bootstrap-1.20.3-x86_64.tar.gz" \
+      -C "$srcdir/crystal-bootstrap" --strip-components 2
+
+    local archive
+    for archive in llvm21-libs-21.1.8-1 libffi-3.5.2-1 libedit-20250104_3.1-1 \
+      zlib-1.3.2-2 zstd-1.5.7-3 libxml2-2.15.2-1 ncurses-6.5-4 icu-78.2-2; do
+      bsdtar --no-same-owner -xf "$srcdir/${archive}-x86_64.pkg.tar.zst" \
+        -C "$srcdir/crystal-x86-runtime"
+    done
+  fi
 }
 
 build() {
   cd "${pkgbase}-${pkgver}"
 
+  local make_args=()
+  if [[ $CARCH == riscv64 ]]; then
+    local bootstrap="$srcdir/crystal-bootstrap"
+    local runtime="$srcdir/crystal-x86-runtime/usr/lib"
+    local x86_gcc_lib
+    local llvm_version llvm_targets llvm_ldflags
+
+    x86_gcc_lib=$(dirname "$(x86_64-linux-gnu-gcc -print-file-name=libstdc++.so.6)")
+    llvm_version=$(llvm-config --version)
+    llvm_targets=$(llvm-config --targets-built)
+    llvm_ldflags=$(llvm-config --libs --system-libs --ldflags)
+
+    mkdir -p .build/bootstrap
+
+    env \
+      CC="$srcdir/crystal-x86_64-cc" \
+      CRYSTAL_X86_LIBRARY_PATH="/usr/x86_64-linux-gnu/lib:$x86_gcc_lib:$runtime" \
+      CRYSTAL_PATH="lib:src" \
+      CRYSTAL_LIBRARY_PATH="$bootstrap/lib/crystal:$runtime" \
+      CRYSTAL_CONFIG_PATH="lib:src" \
+      CRYSTAL_CONFIG_LIBRARY_PATH="$bootstrap/lib/crystal:$runtime" \
+      CRYSTAL_HAS_WRAPPER=1 \
+      LLVM_VERSION=21.1.8 \
+      LLVM_TARGETS='X86,RISCV' \
+      LLVM_LDFLAGS="-L$runtime -lLLVM-21" \
+      qemu-x86_64-static "$bootstrap/bin/crystal" build \
+        --release --no-debug --cross-compile --target=x86_64-linux-gnu \
+        -Dstrict_multi_assign -Dpreview_overload_order \
+        -Dwithout_interpreter -Dwithout_libxml2 -Dwithout_mt \
+        -Dwithout_openssl -Dwithout_zlib \
+        -o .build/crystal-x86 src/compiler/crystal.cr
+
+    x86_64-linux-gnu-gcc .build/crystal-x86.o -o .build/crystal-x86 \
+      -rdynamic -Wl,-rpath-link,"$runtime" -L"$runtime" -lLLVM-21 \
+      "$bootstrap/lib/crystal/libpcre2-8.a" \
+      "$bootstrap/lib/crystal/libgc.a" \
+      -lpthread -ldl -lm -lstdc++
+
+    env \
+      CC="$srcdir/crystal-x86_64-cc" \
+      CRYSTAL_X86_LIBRARY_PATH="/usr/x86_64-linux-gnu/lib:$x86_gcc_lib:$runtime" \
+      CRYSTAL_PATH="lib:src" \
+      CRYSTAL_LIBRARY_PATH="$bootstrap/lib/crystal:$runtime" \
+      CRYSTAL_CONFIG_PATH="lib:src" \
+      CRYSTAL_CONFIG_LIBRARY_PATH='/usr/lib' \
+      CRYSTAL_HAS_WRAPPER=1 \
+      LLVM_VERSION="$llvm_version" \
+      LLVM_TARGETS="$llvm_targets" \
+      LLVM_LDFLAGS="$llvm_ldflags" \
+      qemu-x86_64-static /usr/x86_64-linux-gnu/lib/ld-linux-x86-64.so.2 \
+        --library-path "/usr/x86_64-linux-gnu/lib:$x86_gcc_lib:$runtime" \
+        .build/crystal-x86 build \
+        --release --no-debug --cross-compile --target=riscv64-linux-gnu \
+        -Dstrict_multi_assign -Dpreview_overload_order \
+        -Dwithout_interpreter -Dwithout_libxml2 -Dwithout_mt \
+        -Dwithout_openssl -Dwithout_zlib \
+        -o .build/bootstrap/crystal src/compiler/crystal.cr
+
+    cc .build/bootstrap/crystal.o -o .build/bootstrap/crystal \
+      -rdynamic $llvm_ldflags -lstdc++ -lm \
+      $(pkg-config --libs libpcre2-8 bdw-gc)
+
+    make_args=(CRYSTAL="$PWD/.build/bootstrap/crystal")
+  fi
+
   make release=1 interpreter=1 progress=1 \
        FLAGS="--release --no-debug" \
        CRYSTAL_CONFIG_PATH="lib:/usr/lib/crystal" \
-       CRYSTAL_CACHE_DIR="/tmp/crystal"
+       CRYSTAL_CACHE_DIR="/tmp/crystal" \
+       "${make_args[@]}"
 
-  make docs CRYSTAL_CACHE_DIR="/tmp/crystal"
+  make docs CRYSTAL_CACHE_DIR="/tmp/crystal" "${make_args[@]}"
 
-  make man/
+  make man/ "${make_args[@]}"
 }
 
