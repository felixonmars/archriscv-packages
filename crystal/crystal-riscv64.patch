+  private def load_abi_cast(value_ptr, abi_arg_type)
+    cast = abi_arg_type.cast.not_nil!
+    offsets = abi_arg_type.cast_offsets.not_nil!
+    if cast.kind != LLVM::Type::Kind::Struct
+      value = load(cast, gep(llvm_context.int8, value_ptr, offsets[0]))
+      value.alignment = abi_field_alignment(abi_arg_type, offsets[0])
+      return value
+    end
+
+    value = cast.undef
+
+    cast.struct_element_types.each_with_index do |type, index|
+      offset = offsets[index]
+      field_ptr = gep(llvm_context.int8, value_ptr, offset)
+      field = load(type, field_ptr)
+      field.alignment = abi_field_alignment(abi_arg_type, offset)
+      value = insert_value(value, field, index)
+    end
+
+    value
+  end
+
+  private def store_abi_cast(value, value_ptr, abi_arg_type)
+    cast = abi_arg_type.cast.not_nil!
+    if cast.kind != LLVM::Type::Kind::Struct
+      store = self.store(value, gep(llvm_context.int8, value_ptr, abi_arg_type.cast_offsets.not_nil![0]))
+      store.alignment = abi_field_alignment(abi_arg_type, abi_arg_type.cast_offsets.not_nil![0])
+      return
+    end
+
+    cast.struct_element_types.each_with_index do |type, index|
+      offset = abi_arg_type.cast_offsets.not_nil![index]
+      field_ptr = gep(llvm_context.int8, value_ptr, offset)
+      store = self.store(extract_value(value, index), field_ptr)
+      store.alignment = abi_field_alignment(abi_arg_type, offset)
+    end
+  end
+
+  private def abi_field_alignment(abi_arg_type, offset)
+    align = @abi.align(abi_arg_type.type)
+    return align if offset == 0
+
+    Math.min(align, offset & -offset)
+  end
