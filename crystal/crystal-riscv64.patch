diff -ruN --no-dereference '--exclude=.git' '--exclude=linux' crystal-upstream/spec/compiler/codegen/abi/riscv64_spec.cr crystal-riscv-src/spec/compiler/codegen/abi/riscv64_spec.cr
--- crystal-upstream/spec/compiler/codegen/abi/riscv64_spec.cr	1970-01-01 00:00:00.000000000 +0000
+++ crystal-riscv-src/spec/compiler/codegen/abi/riscv64_spec.cr	2026-09-12 14:12:08.216610598 +0000
@@ -0,0 +1,187 @@
+require "../../../spec_helper"
+require "compiler/crystal/codegen/abi/riscv64"
+
+{% if LibLLVM::BUILT_TARGETS.includes?(:riscv) %}
+  LLVM.init_riscv
+{% end %}
+
+private def riscv64_abi
+  triple = "riscv64-unknown-linux-gnu"
+  target = LLVM::Target.from_triple(triple)
+  machine = target.create_target_machine(triple, cpu: "generic-rv64", features: "+m,+a,+f,+d,+c")
+  machine.enable_global_isel = false
+  Crystal::ABI::RISCV64.new(machine)
+end
+
+private def riscv64_types(source, *names)
+  result = semantic("#{source}\n0")
+  lib_type = result.program.types["LibTest"]
+  {result.program, names.map { |name| lib_type.types[name].as(Crystal::Type) }.to_a}
+end
+
+private def riscv64_test(message, &block : Crystal::ABI::RISCV64, LLVM::Context ->)
+  it message do
+    block.call(riscv64_abi, LLVM::Context.new)
+  end
+end
+
+class Crystal::ABI
+  describe RISCV64 do
+    {% if LibLLVM::BUILT_TARGETS.includes?(:riscv) %}
+      riscv64_test "uses the RV64 data layout" do |abi, ctx|
+        abi.align(ctx.int1).should eq(1)
+        abi.align(ctx.int32).should eq(4)
+        abi.align(ctx.int64).should eq(8)
+        abi.align(ctx.int128).should eq(16)
+        abi.align(ctx.void_pointer).should eq(8)
+        abi.size(ctx.struct([ctx.int8, ctx.int64])).should eq(16)
+      end
+
+      riscv64_test "keeps pointer-represented static arrays scalar" do |abi, ctx|
+        program = semantic("0").program
+        type = program.static_array_of(program.uint8, 4)
+        pointer = ctx.void_pointer
+        info = abi.abi_info([pointer], pointer, true, ctx, [type] of Crystal::Type, type, 1)
+
+        info.arg_types[0].should eq(ArgType.direct(pointer))
+        info.return_type.should eq(ArgType.direct(pointer))
+      end
+
+      riscv64_test "extends integer scalars according to the psABI" do |abi, ctx|
+        program = semantic("0").program
+        types = [program.int8, program.uint8, program.int32, program.uint32, program.int64] of Crystal::Type
+        llvm_types = [ctx.int8, ctx.int8, ctx.int32, ctx.int32, ctx.int64]
+        info = abi.abi_info(llvm_types, ctx.void, false, ctx, types, program.nil_type, types.size)
+
+        info.arg_types.map(&.attr).should eq([
+          LLVM::Attribute::SExt,
+          LLVM::Attribute::ZExt,
+          LLVM::Attribute::SExt,
+          LLVM::Attribute::SExt,
+          nil,
+        ])
+      end
+
+      riscv64_test "flattens eligible floating-point aggregates" do |abi, ctx|
+        _, types = riscv64_types(<<-CRYSTAL, "Pair", "Mixed", "Padded")
+          lib LibTest
+            struct Pair
+              x : Float32
+              y : Float64
+            end
+
+            struct Mixed
+              x : Float64
+              y : Int32
+            end
+
+            struct Padded
+              x : Int8
+              y : Float64
+            end
+          end
+          CRYSTAL
+
+        llvm_types = [
+          ctx.struct([ctx.float, ctx.double]),
+          ctx.struct([ctx.double, ctx.int32]),
+          ctx.struct([ctx.int8, ctx.double]),
+        ]
+        info = abi.abi_info(llvm_types, ctx.void, false, ctx, types, types[0], types.size)
+
+        info.arg_types[0].cast.should eq(ctx.struct([ctx.float, ctx.double]))
+        info.arg_types[0].cast_offsets.should eq([0, 8])
+        info.arg_types[1].cast.should eq(ctx.struct([ctx.double, ctx.int32]))
+        info.arg_types[1].cast_offsets.should eq([0, 8])
+        info.arg_types[2].cast.should eq(ctx.struct([ctx.int8, ctx.double]))
+        info.arg_types[2].cast_offsets.should eq([0, 8])
+      end
+
+      riscv64_test "uses the integer convention for unions and variadic aggregates" do |abi, ctx|
+        _, types = riscv64_types(<<-CRYSTAL, "Pair", "Value")
+          lib LibTest
+            struct Pair
+              x : Float64
+              y : Int32
+            end
+
+            union Value
+              x : Float64
+              y : Int64
+            end
+          end
+          CRYSTAL
+
+        pair = ctx.struct([ctx.double, ctx.int32])
+        union_value = ctx.struct([ctx.int64])
+        info = abi.abi_info([pair, union_value], ctx.void, false, ctx, types, types[0], 0)
+
+        info.arg_types[0].cast.should eq(ctx.int64.array(2))
+        info.arg_types[0].cast_offsets.should be_nil
+        info.arg_types[1].cast.should eq(ctx.int64)
+      end
+
+      riscv64_test "passes large aggregates indirectly without byval" do |abi, ctx|
+        _, types = riscv64_types(<<-CRYSTAL, "Large")
+          lib LibTest
+            struct Large
+              x : Int64
+              y : Int64
+              z : Int64
+            end
+          end
+          CRYSTAL
+
+        large = ctx.struct([ctx.int64, ctx.int64, ctx.int64])
+        info = abi.abi_info([large], large, true, ctx, types, types[0], 1)
+
+        info.arg_types[0].should eq(ArgType.indirect(large, nil))
+        info.return_type.should eq(ArgType.indirect(large, LLVM::Attribute::StructRet))
+      end
+
+      riscv64_test "accounts for the hidden sret pointer" do |abi, ctx|
+        program, types = riscv64_types(<<-CRYSTAL, "Mixed", "Large")
+          lib LibTest
+            struct Mixed
+              x : Float64
+              y : Int64
+            end
+
+            struct Large
+              x : Int64
+              y : Int64
+              z : Int64
+            end
+          end
+          CRYSTAL
+
+        arg_types = Array(Crystal::Type).new(8, program.int64)
+        arg_types << types[0]
+        llvm_types = Array(LLVM::Type).new(8, ctx.int64)
+        llvm_types << ctx.struct([ctx.double, ctx.int64])
+        large = ctx.struct([ctx.int64, ctx.int64, ctx.int64])
+        info = abi.abi_info(llvm_types, large, true, ctx, arg_types, types[1], arg_types.size)
+
+        info.arg_types.last.cast.should eq(ctx.int64.array(2))
+      end
+
+      riscv64_test "keeps zero-sized arguments and aligned aggregates representable" do |abi, ctx|
+        program, types = riscv64_types(<<-CRYSTAL, "Aligned")
+          lib LibTest
+            struct Aligned
+              x : Int128
+            end
+          end
+          CRYSTAL
+
+        empty = ctx.int8.array(0)
+        aligned = ctx.struct([ctx.int128])
+        arg_types = [program.static_array_of(program.uint8, 0), types[0]] of Crystal::Type
+        info = abi.abi_info([empty, aligned], ctx.void, false, ctx, arg_types, types[0], arg_types.size)
+
+        info.arg_types[0].should eq(ArgType.direct(empty, ctx.int64.array(0)))
+        info.arg_types[1].should eq(ArgType.direct(aligned, ctx.int128))
+      end
+    {% end %}
+  end
+end
diff -ruN --no-dereference '--exclude=.git' '--exclude=linux' crystal-upstream/src/compiler/crystal/codegen/abi/riscv64.cr crystal-riscv-src/src/compiler/crystal/codegen/abi/riscv64.cr
--- crystal-upstream/src/compiler/crystal/codegen/abi/riscv64.cr	1970-01-01 00:00:00.000000000 +0000
+++ crystal-riscv-src/src/compiler/crystal/codegen/abi/riscv64.cr	2026-09-12 14:12:08.241610572 +0000
@@ -0,0 +1,227 @@
+require "../abi"
+
+# RISC-V ELF psABI, LP64D calling convention.
+# https://github.com/riscv-non-isa/riscv-elf-psabi-doc/blob/master/riscv-cc.adoc
+class Crystal::ABI::RISCV64 < Crystal::ABI
+  enum FieldKind
+    Integer
+    Float
+  end
+
+  record Field, kind : FieldKind, type : LLVM::Type, offset : Int32
+
+  private class State
+    property gprs : Int32
+    property fprs : Int32
+    property? varargs_on_stack : Bool
+
+    def initialize(@gprs = 8, @fprs = 8, @varargs_on_stack = false)
+    end
+  end
+
+  def align(type : LLVM::Type) : Int32
+    target_data.abi_alignment(type).to_i32
+  end
+
+  def size(type : LLVM::Type) : Int32
+    target_data.abi_size(type).to_i32
+  end
+
+  def abi_info(atys : Array(LLVM::Type), rty : LLVM::Type, ret_def : Bool,
+               context : LLVM::Context) : Crystal::ABI::FunctionType
+    raise "RISC-V ABI classification requires semantic C types"
+  end
+
+  def abi_info(atys : Array(LLVM::Type), rty : LLVM::Type, ret_def : Bool,
+               context : LLVM::Context, arg_types : Array(Crystal::Type),
+               return_type : Crystal::Type, fixed_args : Int32) : Crystal::ABI::FunctionType
+    state = State.new
+
+    ret_ty = if ret_def
+               classify_return(rty, return_type, context)
+             else
+               ArgType.direct(context.void)
+             end
+    consume_gprs(state, 1) if ret_ty.kind.indirect?
+
+    args = atys.zip(arg_types).map_with_index do |types, index|
+      classify_argument(types[0], types[1], context, state, vararg: index >= fixed_args)
+    end
+    FunctionType.new(args, ret_ty)
+  end
+
+  private def classify_return(llvm_type, type, context)
+    if aggregate?(type, llvm_type)
+      if cast = float_aggregate_cast(type, llvm_type, context, 2, 2)
+        return cast
+      end
+
+      return integer_aggregate(llvm_type, context, return_value: true)
+    end
+
+    scalar(llvm_type, type)
+  end
+
+  private def classify_argument(llvm_type, type, context, state, *, vararg)
+    if aggregate?(type, llvm_type)
+      unless vararg
+        if cast = float_aggregate_cast(type, llvm_type, context, state.gprs, state.fprs)
+          fields = cast.cast_offsets.not_nil!.size
+          float_fields = cast.cast.not_nil!.kind == LLVM::Type::Kind::Struct ?
+                           cast.cast.not_nil!.struct_element_types.count { |field| float?(field) } : 1
+          consume_fprs(state, float_fields)
+          consume_gprs(state, fields - float_fields)
+          return cast
+        end
+      end
+
+      arg = integer_aggregate(llvm_type, context, return_value: false)
+      if arg.kind.indirect?
+        consume_integer_argument(state, context.void_pointer, vararg)
+      else
+        consume_integer_argument(state, llvm_type, vararg)
+      end
+      return arg
+    end
+
+    if float?(llvm_type) && !vararg && state.fprs > 0
+      consume_fprs(state, 1)
+    else
+      consume_integer_argument(state, llvm_type, vararg)
+    end
+    scalar(llvm_type, type)
+  end
+
+  private def scalar(llvm_type, type)
+    type = underlying_type(type)
+    attr = case type
+           when BoolType
+             LLVM::Attribute::ZExt
+           when CharType
+             LLVM::Attribute::SExt
+           when IntegerType
+             if type.bits == 32
+               LLVM::Attribute::SExt
+             elsif type.bits < 64
+               type.signed? ? LLVM::Attribute::SExt : LLVM::Attribute::ZExt
+             end
+           when EnumType
+             base = type.base_type
+             if base.bits == 32
+               LLVM::Attribute::SExt
+             elsif base.bits < 64
+               base.signed? ? LLVM::Attribute::SExt : LLVM::Attribute::ZExt
+             end
+           end
+    ArgType.direct(llvm_type, attr: attr)
+  end
+
+  private def integer_aggregate(llvm_type, context, *, return_value)
+    bytes = size(llvm_type)
+    if bytes == 0
+      ArgType.direct(llvm_type, context.int64.array(0))
+    elsif bytes > 16
+      ArgType.indirect(llvm_type, return_value ? LLVM::Attribute::StructRet : nil)
+    elsif bytes <= 8
+      ArgType.direct(llvm_type, context.int64)
+    else
+      cast = align(llvm_type) > 8 ? context.int128 : context.int64.array(2)
+      ArgType.direct(llvm_type, cast)
+    end
+  end
+
+  private def float_aggregate_cast(type, llvm_type, context, gprs, fprs)
+    fields = [] of Field
+    return unless flatten(type, llvm_type, 0, fields)
+    return if fields.empty? || fields.size > 2
+
+    float_fields = fields.count(&.kind.float?)
+    integer_fields = fields.size - float_fields
+    return if float_fields == 0 || float_fields > fprs || integer_fields > gprs
+
+    cast = if fields.size == 1
+             fields[0].type
+           else
+             context.struct(fields.map(&.type))
+           end
+    ArgType.direct(llvm_type, cast, cast_offsets: fields.map(&.offset))
+  end
+
+  private def flatten(type, llvm_type, base_offset, fields) : Bool
+    type = underlying_type(type)
+
+    case type
+    when FloatType
+      return false if size(llvm_type) > 8
+      fields << Field.new(FieldKind::Float, llvm_type, base_offset)
+    when IntegerType, BoolType, CharType, EnumType, PointerInstanceType,
+         ProcInstanceType, NilableProcType
+      return false if size(llvm_type) > 8
+      fields << Field.new(FieldKind::Integer, llvm_type, base_offset)
+    when StaticArrayInstanceType
+      element_type = llvm_type.element_type
+      type.size.as(NumberLiteral).value.to_i.times do |index|
+        return false unless flatten(type.element_type, element_type,
+          base_offset + index * size(element_type), fields)
+        return false if fields.size > 2
+      end
+    when InstanceVarContainer
+      return false unless type.extern?
+      return size(llvm_type) == 0 if type.extern_union?
+
+      llvm_fields = llvm_type.struct_element_types
+      type.all_instance_vars.each_value.with_index do |var, index|
+        offset = target_data.offset_of_element(llvm_type, index).to_i32
+        return false unless flatten(var.type, llvm_fields[index], base_offset + offset, fields)
+        return false if fields.size > 2
+      end
+    else
+      return false
+    end
+
+    true
+  end
+
+  private def aggregate?(type, llvm_type)
+    return false if llvm_type.kind == LLVM::Type::Kind::Pointer
+
+    type = underlying_type(type)
+    type.is_a?(StaticArrayInstanceType) || (type.is_a?(InstanceVarContainer) && type.extern?)
+  end
+
+  private def underlying_type(type)
+    type = type.remove_alias
+    while type.is_a?(TypeDefType)
+      type = type.typedef.remove_alias
+    end
+    type
+  end
+
+  private def float?(type : LLVM::Type)
+    type.kind.in?(LLVM::Type::Kind::Float, LLVM::Type::Kind::Double)
+  end
+
+  private def consume_integer_argument(state, type, vararg)
+    return if size(type) == 0
+
+    registers = size(type) > 8 ? 2 : 1
+    if vararg && registers == 2 && align(type) > 8
+      state.gprs -= state.gprs % 2
+    end
+
+    if state.varargs_on_stack? || state.gprs == 0 || (vararg && registers == 2 && state.gprs < 2)
+      state.gprs = 0 if vararg
+      state.varargs_on_stack = true if vararg
+    else
+      consume_gprs(state, registers)
+    end
+  end
+
+  private def consume_gprs(state, count)
+    state.gprs = Math.max(0, state.gprs - count)
+  end
+
+  private def consume_fprs(state, count)
+    state.fprs = Math.max(0, state.fprs - count)
+  end
+end
