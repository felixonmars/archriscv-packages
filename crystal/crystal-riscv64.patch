diff -ruN --no-dereference '--exclude=.git' '--exclude=linux' crystal-upstream/src/fiber/context/riscv64.cr crystal-riscv-src/src/fiber/context/riscv64.cr
--- crystal-upstream/src/fiber/context/riscv64.cr	1970-01-01 00:00:00.000000000 +0000
+++ crystal-riscv-src/src/fiber/context/riscv64.cr	2026-09-12 14:12:08.209610606 +0000
@@ -0,0 +1,100 @@
+{% skip_file unless flag?(:riscv64) %}
+
+class Fiber
+  # :nodoc:
+  def makecontext(stack_ptr, fiber_main) : Nil
+    # ra, s0-s11, a0, fs0-fs11, fcsr, and one padding slot
+    @context.stack_top = (stack_ptr - 28).as(Void*)
+    @context.resumable = 1
+
+    stack_ptr[-28] = fiber_main.pointer # ra
+    stack_ptr[-15] = self.as(Void*)     # a0
+    stack_ptr[-2] = Pointer(Void).null  # fcsr
+  end
+
+  # :nodoc:
+  @[NoInline]
+  @[Naked]
+  def self.swapcontext(current_context, new_context) : Nil
+    #                  a0,              a1
+    {% begin %}
+      asm("
+    addi sp, sp, -224
+
+    sd ra, 0(sp)
+    sd s0, 8(sp)
+    sd s1, 16(sp)
+    sd s2, 24(sp)
+    sd s3, 32(sp)
+    sd s4, 40(sp)
+    sd s5, 48(sp)
+    sd s6, 56(sp)
+    sd s7, 64(sp)
+    sd s8, 72(sp)
+    sd s9, 80(sp)
+    sd s10, 88(sp)
+    sd s11, 96(sp)
+    sd a0, 104(sp)
+
+    fsd fs0, 112(sp)
+    fsd fs1, 120(sp)
+    fsd fs2, 128(sp)
+    fsd fs3, 136(sp)
+    fsd fs4, 144(sp)
+    fsd fs5, 152(sp)
+    fsd fs6, 160(sp)
+    fsd fs7, 168(sp)
+    fsd fs8, 176(sp)
+    fsd fs9, 184(sp)
+    fsd fs10, 192(sp)
+    fsd fs11, 200(sp)
+    frcsr t0
+    sd t0, 208(sp)
+
+    sd sp, 0(a0)
+    {% unless flag?(:without_mt) %}
+    fence rw, rw
+    {% end %}
+    li t0, 1
+    sd t0, 8(a0)
+
+    sd zero, 8(a1)
+    ld sp, 0(a1)
+
+    ld t0, 0(sp)
+    ld s0, 8(sp)
+    ld s1, 16(sp)
+    ld s2, 24(sp)
+    ld s3, 32(sp)
+    ld s4, 40(sp)
+    ld s5, 48(sp)
+    ld s6, 56(sp)
+    ld s7, 64(sp)
+    ld s8, 72(sp)
+    ld s9, 80(sp)
+    ld s10, 88(sp)
+    ld s11, 96(sp)
+
+    fld fs0, 112(sp)
+    fld fs1, 120(sp)
+    fld fs2, 128(sp)
+    fld fs3, 136(sp)
+    fld fs4, 144(sp)
+    fld fs5, 152(sp)
+    fld fs6, 160(sp)
+    fld fs7, 168(sp)
+    fld fs8, 176(sp)
+    fld fs9, 184(sp)
+    fld fs10, 192(sp)
+    fld fs11, 200(sp)
+    ld t1, 208(sp)
+    fscsr t1
+
+    ld a0, 104(sp)
+    addi sp, sp, 224
+    mv ra, zero
+    jr t0
+      ")
+    {% end %}
+  end
+end
