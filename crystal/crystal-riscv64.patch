+  macro def_syscall(name, return_type, *args)
+    @[::AlwaysInline]
+    def self.{{name.id}}({{args.splat}}) : {{return_type}}
+      ret = uninitialized {{return_type}}
+
+      {% if args.size == 0 %}
+        asm("ecall" : "={a0}"(ret)
+                     : "{a7}"(::Syscall::Code::{{name.stringify.upcase.id}})
+                     : "memory"
+                     : "volatile")
+      {% elsif args.size == 1 %}
+        asm("ecall" : "={a0}"(ret)
+                     : "{a7}"(::Syscall::Code::{{name.stringify.upcase.id}}), "{a0}"({{args[0].var.id}})
+                     : "memory"
+                     : "volatile")
+      {% elsif args.size == 2 %}
+        asm("ecall" : "={a0}"(ret)
+                     : "{a7}"(::Syscall::Code::{{name.stringify.upcase.id}}), "{a0}"({{args[0].var.id}}), "{a1}"({{args[1].var.id}})
+                     : "memory"
+                     : "volatile")
+      {% elsif args.size == 3 %}
+        asm("ecall" : "={a0}"(ret)
+                     : "{a7}"(::Syscall::Code::{{name.stringify.upcase.id}}), "{a0}"({{args[0].var.id}}), "{a1}"({{args[1].var.id}}),
+                       "{a2}"({{args[2].var.id}})
+                     : "memory"
+                     : "volatile")
+      {% elsif args.size == 4 %}
+        asm("ecall" : "={a0}"(ret)
+                     : "{a7}"(::Syscall::Code::{{name.stringify.upcase.id}}), "{a0}"({{args[0].var.id}}), "{a1}"({{args[1].var.id}}),
+                       "{a2}"({{args[2].var.id}}), "{a3}"({{args[3].var.id}})
+                     : "memory"
+                     : "volatile")
+      {% elsif args.size == 5 %}
+        asm("ecall" : "={a0}"(ret)
+                     : "{a7}"(::Syscall::Code::{{name.stringify.upcase.id}}), "{a0}"({{args[0].var.id}}), "{a1}"({{args[1].var.id}}),
+                       "{a2}"({{args[2].var.id}}), "{a3}"({{args[3].var.id}}), "{a4}"({{args[4].var.id}})
+                     : "memory"
+                     : "volatile")
+      {% elsif args.size == 6 %}
+        asm("ecall" : "={a0}"(ret)
+                     : "{a7}"(::Syscall::Code::{{name.stringify.upcase.id}}), "{a0}"({{args[0].var.id}}), "{a1}"({{args[1].var.id}}),
+                       "{a2}"({{args[2].var.id}}), "{a3}"({{args[3].var.id}}), "{a4}"({{args[4].var.id}}), "{a5}"({{args[5].var.id}})
+                     : "memory"
+                     : "volatile")
+      {% else %}
+        {% raise "Not supported number of arguments for syscall" %}
+      {% end %}
+
+      ret
+    end
+  end
+end
