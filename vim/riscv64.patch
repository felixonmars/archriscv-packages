--- PKGBUILD
+++ PKGBUILD
@@ -45,6 +45,16 @@
 validpgpkeys=('4F19708816918E19AAE19DEEF3F92DA383FDDE09') # Christian Brabandt <cb@256bit.org>
 
 prepare() {
+  (cd vim
+    # Wait for asynchronous gdb output before checking breakpoint signs.
+    patch -Np1 -i ../fix-termdebug-remote-test-wait.patch
+    # Forward Perl's variadic errors through its va_list API.
+    patch -Np1 -i ../fix-perl-croak-varargs.patch
+    # Keep the row-limit regression test within its timeout on slow builders.
+    patch -Np1 -i ../fix-terminal-csi-resize-test.patch
+    # Allow slow builders to finish crash fixtures, GDB startup and terminal I/O.
+    patch -Np1 -i ../fix-slow-test-timeouts.patch
+  )
   (cd vim/src
     # define the place for the global (g)vimrc file (set to /etc/vimrc)
     sed -E 's|^.*(#define SYS_.*VIMRC_FILE.*").*$|\1|g' -i feature.h
@@ -215,4 +225,11 @@
   install -Dm 644 "${srcdir}"/vimdoc.hook "${pkgdir}"/usr/share/libalpm/hooks/vimdoc.hook
 }
 
+source+=(fix-termdebug-remote-test-wait.patch fix-perl-croak-varargs.patch
+         fix-terminal-csi-resize-test.patch fix-slow-test-timeouts.patch)
