--- PKGBUILD
+++ PKGBUILD
@@ -77,7 +77,9 @@
     cd "$pkgname-$pkgver-src"
     export JAVA_HOME="/usr/lib/jvm/java-${_jdkver}-openjdk"
     export PATH="/usr/lib/jvm/java-${_jdkver}-openjdk/bin:$PATH"
+    # Do not leave a daemon that check() would reuse without LD_PRELOAD.
     ./gradlew \
+        --no-daemon \
         -PscalaVersion=$_scalaver \
         compileJava \
         compileScala \
@@ -94,8 +96,11 @@
 check() {
     cd "$pkgname-$pkgver-src"
     export JAVA_HOME="/usr/lib/jvm/java-${_jdkver}-openjdk"
+    # rocksdbjni's riscv64 library does not declare its libatomic dependency.
+    export LD_PRELOAD=/usr/lib/libatomic.so.1
     export PATH="/usr/lib/jvm/java-${_jdkver}-openjdk/bin:$PATH"
     ./gradlew \
+        --no-daemon \
         -PscalaVersion=$_scalaver \
         --continue \
         -PkeepAliveMode=session \
@@ -111,6 +116,17 @@
     local _sh_script
     cd "$pkgname-$pkgver-src/dist"
 
+    # Make the libatomic workaround persist in the installed RocksDB JNI library.
+    bsdtar -xf libs/rocksdbjni-*.jar \
+        -C "$srcdir" \
+        librocksdbjni-linux-riscv64.so
+    patchelf --add-needed libatomic.so.1 \
+        "$srcdir/librocksdbjni-linux-riscv64.so"
+    jar --update \
+        --file libs/rocksdbjni-*.jar \
+        -C "$srcdir" \
+        librocksdbjni-linux-riscv64.so
+
     # remove unneeded and OS specific scripts
     rm -rvf bin/windows
 
@@ -150,3 +166,6 @@
     install -vDm 644 $srcdir/$pkgname.sysusers "$pkgdir/usr/lib/sysusers.d/$pkgname.conf"
     install -vDm 644 $srcdir/$pkgname.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/$pkgname.conf"
 }
+
+depends+=(libatomic)
+makedepends+=(patchelf)
