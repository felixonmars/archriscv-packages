--- PKGBUILD
+++ PKGBUILD
@@ -31,5 +31,10 @@
 
 prepare() {
-  cd "${pkgbase}-${pkgver}"
+  cd lightningcss-1.32.0
+  cargo fetch --locked --target host-tuple
+  cd "$srcdir/tailwindcss-4.3.3"
+  cargo fetch --locked --target host-tuple
+
+  cd "$srcdir/${pkgbase}-${pkgver}"
   cargo fetch --locked --target host-tuple
 
@@ -43,5 +48,15 @@
 
 build() {
-  cd ${pkgbase}-${pkgver}
+  # These frontend dependencies do not publish native riscv64 bindings.
+  cd lightningcss-1.32.0
+  cargo build --frozen --release -p lightningcss_node
+  cd "$srcdir/tailwindcss-4.3.3"
+  cargo build --frozen --release -p tailwind-oxide
+
+  cd "$srcdir/${pkgbase}-${pkgver}"
+  install -m755 "$srcdir/lightningcss-1.32.0/target/release/liblightningcss_node.so" \
+    node_modules/lightningcss/lightningcss.linux-riscv64-gnu.node
+  install -m755 "$srcdir/tailwindcss-4.3.3/target/release/libtailwind_oxide.so" \
+    node_modules/@tailwindcss/oxide/tailwindcss-oxide.linux-riscv64-gnu.node
   export CFLAGS+=" -ffat-lto-objects"
   cargo build -p rqbit --frozen --release
