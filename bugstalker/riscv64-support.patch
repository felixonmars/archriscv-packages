+impl Register {
+    pub const PC: Self = Self::Pc;
+    pub const SP: Self = Self::Sp;
+
+    pub fn dwarf_register(self) -> Option<gimli::Register> {
+        match self {
+            Self::Pc | Self::Fcsr => None,
+            _ => Some(gimli::Register(self as u16)),
+        }
+    }
+}
+
+impl From<gimli::Register> for Register {
+    fn from(value: gimli::Register) -> Self {
+        Self::from_repr(value.0).expect("unknown RISC-V DWARF register")
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct RegisterMap {
+    // NT_PRSTATUS starts with PC, followed by x1 through x31. x0 is not stored.
+    general: [u64; 32],
+    // Linux's __riscv_d_ext_state: 32 FP registers, fcsr and trailing padding.
+    floating: [u64; 33],
+}
+
+fn regset(pid: Pid, request: libc::c_uint, note: usize, data: &mut [u64]) -> Result<(), Error> {
+    let mut iov = libc::iovec {
+        iov_base: data.as_mut_ptr().cast(),
+        iov_len: size_of_val(data),
+    };
+    let result = unsafe { libc::ptrace(request, pid.as_raw(), note, &mut iov as *mut libc::iovec) };
+    Errno::result(result).map_err(Error::Ptrace)?;
+    if iov.iov_len != size_of_val(data) {
+        return Err(Error::Ptrace(Errno::EIO));
+    }
+    Ok(())
+}
+
+impl RegisterMap {
+    pub fn current(pid: Pid) -> Result<Self, Error> {
+        let mut map = Self {
+            general: [0; 32],
+            floating: [0; 33],
+        };
+        regset(pid, libc::PTRACE_GETREGSET, 1, &mut map.general)?; // NT_PRSTATUS
+        regset(pid, libc::PTRACE_GETREGSET, 2, &mut map.floating)?; // NT_PRFPREG
+        Ok(map)
+    }
+
+    pub fn value(&self, register: impl Into<Register>) -> u64 {
+        match register.into() {
+            Register::Zero => 0,
+            Register::Pc => self.general[0],
+            Register::Fcsr => self.floating[32] & 0xffff_ffff,
+            reg if (reg as usize) < 32 => self.general[reg as usize],
+            reg => self.floating[reg as usize - 32],
+        }
+    }
+
+    pub fn update(&mut self, register: impl Into<Register>, value: u64) {
+        match register.into() {
+            Register::Zero => {}
+            Register::Pc => self.general[0] = value,
+            Register::Fcsr => self.floating[32] = value & 0xffff_ffff,
+            reg if (reg as usize) < 32 => self.general[reg as usize] = value,
+            reg => self.floating[reg as usize - 32] = value,
+        }
+    }
+
+    pub fn persist(mut self, pid: Pid) -> Result<(), Error> {
+        regset(pid, libc::PTRACE_SETREGSET, 2, &mut self.floating)?;
+        regset(pid, libc::PTRACE_SETREGSET, 1, &mut self.general)
+    }
+
+    pub(crate) fn integer(&self, number: u32) -> u64 {
+        if number == 0 {
+            0
+        } else {
+            self.general[number as usize]
+        }
+    }
+}
+
+impl From<RegisterMap> for DwarfRegisterMap {
+    fn from(map: RegisterMap) -> Self {
+        let mut values = smallvec![None; 0x80];
+        for register in Register::iter() {
+            if let Some(dwarf) = register.dwarf_register() {
+                values[dwarf.0 as usize] = Some(map.value(register));
+            }
+        }
+        Self(values)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn linux_and_dwarf_register_layouts() {
+        let mut map = RegisterMap {
+            general: [0; 32],
+            floating: [0; 33],
+        };
+        map.update(Register::PC, 0x1000);
+        map.update(Register::Zero, 99);
+        map.update(Register::Ra, 0x2000);
+        map.update(Register::Sp, 0x3000);
+        map.update(Register::Fa0, 42);
+        assert_eq!(map.general[0], 0x1000);
+        assert_eq!(map.general[1], 0x2000);
+        assert_eq!(map.value(Register::Zero), 0);
+        assert_eq!("x10".parse::<Register>().unwrap(), Register::A0);
+        assert_eq!("fp".parse::<Register>().unwrap(), Register::S0);
+        let dwarf: DwarfRegisterMap = map.into();
+        assert_eq!(dwarf.value(gimli::Register(0)).unwrap(), 0);
+        assert_eq!(dwarf.value(gimli::Register(1)).unwrap(), 0x2000);
+        assert_eq!(dwarf.value(gimli::Register(2)).unwrap(), 0x3000);
+        assert_eq!(dwarf.value(gimli::Register(42)).unwrap(), 42);
+    }
+}
