+    #[test]
+    #[serial_test::serial]
+    fn native_compressed_atomic_step_and_page_boundary() {
+        use nix::{
+            libc,
+            sys::{
+                ptrace,
+                signal::Signal,
+                wait::{WaitStatus, waitpid},
+            },
+            unistd::{ForkResult, fork},
+        };
+        use std::ptr;
+
+        struct Child(Pid);
+        impl Drop for Child {
+            fn drop(&mut self) {
+                unsafe {
+                    libc::kill(self.0.as_raw(), libc::SIGKILL);
+                }
+                let _ = waitpid(self.0, None);
+            }
+        }
+        struct Mapping(*mut libc::c_void, usize);
+        impl Drop for Mapping {
+            fn drop(&mut self) {
+                unsafe {
+                    libc::munmap(self.0, self.1);
+                }
+            }
+        }
+
+        let page = unsafe { libc::sysconf(libc::_SC_PAGESIZE) as usize };
+        let memory = unsafe {
+            libc::mmap(
+                ptr::null_mut(),
+                2 * page,
+                libc::PROT_READ | libc::PROT_WRITE | libc::PROT_EXEC,
+                libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
+                -1,
+                0,
+            )
+        };
+        assert_ne!(memory, libc::MAP_FAILED);
+        let mapping = Mapping(memory, 2 * page);
+        let address = memory as usize;
+        unsafe {
+            // c.addi a0,1; c.nop, and a return at the very end of the mapped page.
+            ptr::copy_nonoverlapping([0x05u8, 0x05, 0x01, 0x00].as_ptr(), memory.cast(), 4);
+            // lr.d a1,(a0); addi a1,a1,1; sc.d a2,a1,(a0).
+            let atomic = [0x100535afu32, 0x00158593, 0x18b5362f];
+            ptr::copy_nonoverlapping(atomic.as_ptr().cast::<u8>(), (address + 16) as *mut u8, 12);
+            ptr::copy_nonoverlapping([0x82u8, 0x80].as_ptr(), (address + page - 2) as *mut u8, 2);
+            assert_eq!(
+                libc::mprotect((address + page) as *mut _, page, libc::PROT_NONE),
+                0
+            );
+        }
+        let pid = match unsafe { fork().unwrap() } {
+            ForkResult::Child => unsafe {
+                // Only async-signal-safe operations between fork and the parent's ptrace control.
+                // Ptrace can read PROT_NONE pages, so leave this page unmapped in the tracee.
+                if libc::munmap((address + page) as *mut _, page) != 0 {
+                    libc::_exit(1);
+                }
+                if libc::ptrace(
+                    libc::PTRACE_TRACEME,
+                    0,
+                    ptr::null_mut::<libc::c_void>(),
+                    ptr::null_mut::<libc::c_void>(),
+                ) == -1
+                {
+                    libc::_exit(1);
+                }
+                libc::raise(libc::SIGSTOP);
+                libc::_exit(0);
+            },
+            ForkResult::Parent { child } => child,
+        };
+        let child = Child(pid);
+        assert_eq!(
+            waitpid(pid, None).unwrap(),
+            WaitStatus::Stopped(pid, Signal::SIGSTOP)
+        );
+        let mut boundary =
+            StepBreakpoints::install(pid, &[(address + page - 2) as u64], &[]).unwrap();
+        assert_eq!(
+            read_memory_by_pid(pid, address + page - 2, 2).unwrap(),
+            super::super::BREAKPOINT
+        );
+        boundary.restore().unwrap();
+        let mut regs = RegisterMap::current(pid).unwrap();
+        regs.update(Register::PC, (address + page - 2) as u64);
+        regs.update(Register::Ra, address as u64);
+        regs.update(Register::A0, 0);
+        regs.persist(pid).unwrap();
+        for expected in [address, address + 2] {
+            let targets = step_targets(pid).unwrap();
+            assert_eq!(targets, vec![expected as u64]);
+            let mut breakpoints = StepBreakpoints::install(pid, &targets, &[]).unwrap();
+            ptrace::cont(pid, None).unwrap();
+            assert_eq!(
+                waitpid(pid, None).unwrap(),
