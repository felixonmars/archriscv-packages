+            breakpoints.restore().unwrap();
+        }
+        assert_eq!(RegisterMap::current(pid).unwrap().value(Register::A0), 1);
+        assert_eq!(
+            read_memory_by_pid(pid, address, 4).unwrap(),
+            [0x05, 0x05, 0x01, 0x00]
+        );
+        assert_eq!(
+            read_memory_by_pid(pid, address + page - 2, 2).unwrap(),
