+
+impl CallHelper {
+    fn wait_at(ccx: &CallContext, pc: u64) -> Result<(), Error> {
+        let status = nix::sys::wait::waitpid(ccx.pid, None).map_err(Error::Waitpid)?;
+        if status != WaitStatus::Stopped(ccx.pid, Signal::SIGTRAP)
+            || RegisterMap::current(ccx.pid)?.value(Register::PC) != pc
+        {
+            return Err(CallError::UnexpectedStop(status).into());
+        }
+        Ok(())
+    }
+
+    fn syscall(ccx: &CallContext, number: u64, args: &[u64]) -> Result<u64, Error> {
+        // ecall; ebreak. The kernel returns to the second instruction.
+        write_bytes(
+            ccx.pid,
+            ccx.pc.as_usize(),
+            &[0x73, 0, 0, 0, 0x73, 0, 0x10, 0],
+        )
+        .map_err(Error::Ptrace)?;
+        let mut regs = ccx.regs.clone();
+        regs.update(Register::PC, ccx.pc.as_u64());
+        regs.update(Register::A7, number);
+        for (index, &value) in args.iter().enumerate() {
+            regs.update(get_reg_for_no(index, RegType::General), value);
+        }
+        regs.persist(ccx.pid)?;
+        sys::ptrace::cont(ccx.pid, None).map_err(Error::Ptrace)?;
+        Self::wait_at(ccx, ccx.pc.as_u64() + 4)?;
+        Ok(RegisterMap::current(ccx.pid)?.value(Register::A0))
+    }
+
+    pub(super) fn mmap(ccx: &CallContext) -> Result<u64, Error> {
+        let size = unsafe { nix::libc::sysconf(nix::libc::_SC_PAGESIZE) as u64 };
+        let prot = (nix::libc::PROT_READ | nix::libc::PROT_WRITE | nix::libc::PROT_EXEC) as u64;
+        let flags = (nix::libc::MAP_PRIVATE | nix::libc::MAP_ANONYMOUS) as u64;
+        let address = Self::syscall(
+            ccx,
+            nix::libc::SYS_mmap as u64,
+            &[0, size, prot, flags, u64::MAX, 0],
+        )?;
+        if (-4095..0).contains(&(address as i64)) {
+            return Err(CallError::Mmap.into());
+        }
+        debug_assert!(crate::debugger::utils::region_exist(ccx.pid, address)?);
+        Ok(address)
+    }
+
+    pub(super) fn munmap(ccx: &CallContext, address: u64) -> Result<(), Error> {
+        let size = unsafe { nix::libc::sysconf(nix::libc::_SC_PAGESIZE) as u64 };
+        if Self::syscall(ccx, nix::libc::SYS_munmap as u64, &[address, size])? != 0 {
+            return Err(CallError::Munmap.into());
+        }
+        debug_assert!(crate::debugger::utils::region_non_exist(ccx.pid, address)?);
+        Ok(())
+    }
+
+    pub(super) fn jump(ccx: &CallContext, address: u64) -> Result<(), Error> {
+        let mut regs = ccx.regs.clone();
+        regs.update(Register::PC, address);
+        regs.persist(ccx.pid)
+    }
+
+    pub(super) fn call_fn(
+        ccx: &CallContext,
+        pc: u64,
+        address: u64,
+        args: CallArgs,
+    ) -> Result<(), Error> {
+        // jalr ra, 0(t0); ebreak. ra points at the trap when the callee returns.
+        write_bytes(
+            ccx.pid,
+            pc as usize,
+            &[0xe7, 0x80, 0x02, 0, 0x73, 0, 0x10, 0],
+        )
+        .map_err(Error::Ptrace)?;
+        let mut regs = ccx.regs.clone();
+        args.prepare_registers(&mut regs);
+        regs.update(Register::T0, address);
+        regs.update(Register::PC, pc);
+        regs.update(Register::SP, regs.value(Register::SP) & !15);
+        regs.persist(ccx.pid)?;
+        sys::ptrace::cont(ccx.pid, None).map_err(Error::Ptrace)?;
+        Self::wait_at(ccx, pc + 4)
+    }
+}
