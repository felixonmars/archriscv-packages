+    #[test]
+    fn branches_and_compressed_control_flow() {
+        assert_eq!(Instruction(0x008000ef).next(0x1000, |_| 0).unwrap(), 0x1008); // jal ra,+8
+        assert_eq!(
+            Instruction(0xffd08067).next(0x1000, |_| 0x2004).unwrap(),
+            0x2000
+        ); // jalr -3(ra)
+        assert_eq!(Instruction(0xfe000ee3).next(0x1000, |_| 0).unwrap(), 0x0ffc); // beq zero,zero,-4
+        assert_eq!(Instruction(0xa009).next(0x1000, |_| 0).unwrap(), 0x1002); // c.j +2
+        assert_eq!(Instruction(0xbffd).next(0x1000, |_| 0).unwrap(), 0x0ffe); // c.j -2
+        assert_eq!(Instruction(0xc011).next(0x1000, |_| 0).unwrap(), 0x1004); // c.beqz s0,+4
+        assert_eq!(Instruction(0xc011).next(0x1000, |_| 1).unwrap(), 0x1002);
+        assert_eq!(
+            Instruction(0x8082).next(0x1000, |_| 0x2001).unwrap(),
+            0x2000
+        ); // c.jr ra
+        assert_eq!(Instruction(0x9082).link_register(), Some(1));
+        assert_eq!(Instruction(0x9002).link_register(), None); // c.ebreak
+        assert_eq!(Instruction(0x0001).len(), 2);
+        assert_eq!(Instruction(0x00000013).len(), 4);
+    }
+
+    #[test]
+    fn signed_and_unsigned_branches_differ() {
+        let registers = |r| if r == 1 { u64::MAX } else { 1 };
+        assert_eq!(
+            Instruction(0x0020c463).next(0x1000, registers).unwrap(),
+            0x1008
+        ); // blt ra,sp,+8
+        assert_eq!(
+            Instruction(0x0020e463).next(0x1000, registers).unwrap(),
+            0x1004
+        ); // bltu ra,sp,+8
+    }
+
+    #[test]
+    fn atomic_sequence_has_no_interior_breakpoints() {
+        let code = [0x100535af, 0x00b61663, 0x18c536af]; // lr.d; bne +12; sc.d
+        let targets = atomic_targets(0x1000, Instruction(code[0]), |pc| {
+            Ok(Instruction(code[((pc - 0x1000) / 4) as usize]))
+        })
+        .unwrap()
+        .unwrap();
+        assert_eq!(targets, vec![0x100c, 0x1010]);
+    }
