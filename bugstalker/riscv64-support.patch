+//! Software stepping for RV64GC. Linux does not implement PTRACE_SINGLESTEP.
+use crate::debugger::{
+    Error,
+    breakpoint::Breakpoint,
+    read_memory_by_pid,
+    register::{Register, RegisterMap},
+};
+use nix::{errno::Errno, unistd::Pid};
+
+fn signed(value: u32, bits: u32) -> i64 {
+    ((value << (32 - bits)) as i32 >> (32 - bits)) as i64
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Instruction(u32);
+
+impl Instruction {
+    fn read(pid: Pid, pc: u64) -> Result<Self, Error> {
+        let low = read_memory_by_pid(pid, pc as usize, 2).map_err(Error::Ptrace)?;
+        let low = u16::from_le_bytes([low[0], low[1]]) as u32;
+        if low & 3 != 3 {
+            return Ok(Self(low));
+        }
+        if low & 0x1f == 0x1f {
+            return Err(Error::UnsupportedArchitectureFeature(
+                "stepping instructions longer than 32 bits",
+            ));
+        }
+        let high = read_memory_by_pid(pid, pc as usize + 2, 2).map_err(Error::Ptrace)?;
+        Ok(Self(
+            low | ((u16::from_le_bytes([high[0], high[1]]) as u32) << 16),
+        ))
+    }
+
+    fn len(self) -> u64 {
+        if self.0 & 3 == 3 { 4 } else { 2 }
+    }
+
+    // A direct control transfer's displacement, including compressed branches.
+    fn displacement(self) -> Option<i64> {
+        let i = self.0;
+        if self.len() == 2 {
+            match i & 0xe003 {
+                0xa001 => Some(signed(
+                    ((i >> 12 & 1) << 11)
+                        | ((i >> 11 & 1) << 4)
+                        | ((i >> 9 & 3) << 8)
+                        | ((i >> 8 & 1) << 10)
+                        | ((i >> 7 & 1) << 6)
+                        | ((i >> 6 & 1) << 7)
+                        | ((i >> 3 & 7) << 1)
+                        | ((i >> 2 & 1) << 5),
+                    12,
+                )),
+                0xc001 | 0xe001 => Some(signed(
+                    ((i >> 12 & 1) << 8)
+                        | ((i >> 10 & 3) << 3)
+                        | ((i >> 5 & 3) << 6)
+                        | ((i >> 3 & 3) << 1)
+                        | ((i >> 2 & 1) << 5),
+                    9,
+                )),
+                _ => None,
+            }
+        } else {
+            match i & 0x7f {
+                0x6f => Some(signed(
+                    ((i >> 31) << 20)
+                        | ((i >> 12 & 0xff) << 12)
+                        | ((i >> 20 & 1) << 11)
+                        | ((i >> 21 & 0x3ff) << 1),
+                    21,
+                )),
+                0x63 => Some(signed(
+                    ((i >> 31) << 12)
+                        | ((i >> 7 & 1) << 11)
+                        | ((i >> 25 & 0x3f) << 5)
+                        | ((i >> 8 & 0xf) << 1),
+                    13,
+                )),
+                _ => None,
+            }
+        }
+    }
+
+    fn next(self, pc: u64, reg: impl Fn(u32) -> u64) -> Result<u64, Error> {
+        let i = self.0;
+        let sequential = pc.wrapping_add(self.len());
+        if self.len() == 2 {
+            return Ok(match i & 0xe003 {
+                0xa001 => pc.wrapping_add_signed(self.displacement().unwrap()), // c.j
+                0xc001 | 0xe001 => {
+                    let zero = reg(8 + (i >> 7 & 7)) == 0;
+                    if zero == (i & 0xe000 == 0xc000) {
+                        pc.wrapping_add_signed(self.displacement().unwrap())
+                    } else {
+                        sequential
+                    }
+                }
+                // c.jr and c.jalr; exclude c.ebreak (rs1 == 0).
+                0x8002 if i & 0x7c == 0 && i >> 7 & 31 != 0 => reg(i >> 7 & 31) & !1,
+                _ => sequential,
+            });
+        }
+        Ok(match i & 0x7f {
+            0x6f => pc.wrapping_add_signed(self.displacement().unwrap()),
+            0x67 if i >> 12 & 7 == 0 => {
+                reg(i >> 15 & 31).wrapping_add_signed(signed(i >> 20, 12)) & !1
+            }
+            0x63 => {
+                let a = reg(i >> 15 & 31);
+                let b = reg(i >> 20 & 31);
+                let taken = match i >> 12 & 7 {
+                    0 => a == b,
+                    1 => a != b,
+                    4 => (a as i64) < (b as i64),
+                    5 => (a as i64) >= (b as i64),
+                    6 => a < b,
+                    7 => a >= b,
+                    _ => {
+                        return Err(Error::UnsupportedArchitectureFeature(
+                            "reserved RISC-V branch encoding",
+                        ));
+                    }
+                };
+                if taken {
+                    pc.wrapping_add_signed(self.displacement().unwrap())
+                } else {
+                    sequential
+                }
+            }
+            _ => sequential,
+        })
+    }
+
+    fn link_register(self) -> Option<u32> {
+        let i = self.0;
+        if self.len() == 4 && matches!(i & 0x7f, 0x6f | 0x67) {
+            Some(i >> 7 & 31)
+        } else if i & 0xf07f == 0x9002 && i >> 7 & 31 != 0 {
+            Some(1) // c.jalr
+        } else {
+            None
+        }
+    }
+}
+
+// Breaking between LR and SC destroys the reservation on a context switch.
+// Execute the constrained sequence as a unit, trapping on each possible exit.
+fn atomic_targets(
+    pc: u64,
+    first: Instruction,
+    mut read: impl FnMut(u64) -> Result<Instruction, Error>,
+) -> Result<Option<Vec<u64>>, Error> {
+    if first.0 & 0xf9f0_007f != 0x1000_002f {
+        return Ok(None);
+    }
+    let mut address = pc + 4;
+    let mut exits = vec![];
+    for _ in 1..16 {
+        let insn = read(address)?;
+        if insn.0 & 0xf800_007f == 0x1800_002f && insn.0 & 0x000f_f000 == first.0 & 0x000f_f000 {
+            let end = address + 4;
+            exits.retain(|&target| target >= end);
+            exits.push(end);
+            exits.sort_unstable();
+            exits.dedup();
+            return Ok(Some(exits));
+        }
+        if let Some(offset) = insn.displacement() {
+            if offset <= 0 {
+                break;
+            }
+            exits.push(address.wrapping_add_signed(offset));
+        } else {
+            let allowed = if insn.len() == 4 {
+                matches!(insn.0 & 0x7f, 0x13 | 0x1b | 0x33 | 0x3b | 0x37 | 0x17)
+                    && !(matches!(insn.0 & 0x7f, 0x33 | 0x3b) && insn.0 >> 25 & 1 != 0)
+            } else {
+                // Compressed integer arithmetic, excluding loads/stores and indirect jumps.
+                matches!(
+                    insn.0 & 0xe003,
+                    0x0001 | 0x2001 | 0x4001 | 0x6001 | 0x8001 | 0x0002
+                ) || (insn.0 & 0xe003 == 0x8002 && insn.0 & 0x7c != 0)
+            };
+            if !allowed {
+                break;
+            }
+        }
+        address += insn.len();
+    }
+    Err(Error::UnsupportedArchitectureFeature(
+        "stepping an unconstrained RISC-V LR/SC sequence",
+    ))
+}
+
+/// Empty targets mean a self-branch was emulated without overwriting its instruction.
+pub fn step_targets(pid: Pid) -> Result<Vec<u64>, Error> {
+    let mut regs = RegisterMap::current(pid)?;
+    let pc = regs.value(Register::PC);
+    let instruction = Instruction::read(pid, pc)?;
+    if let Some(targets) = atomic_targets(pc, instruction, |p| Instruction::read(pid, p))? {
+        return Ok(targets);
+    }
+    let next = if instruction.0 == 0x73 && regs.value(Register::A7) == 139 {
+        // Linux rt_sigframe: siginfo (128 bytes), ucontext prefix (176 bytes), saved PC.
+        let bytes = read_memory_by_pid(pid, regs.value(Register::SP) as usize + 304, 8)
+            .map_err(Error::Ptrace)?;
+        u64::from_le_bytes(bytes.try_into().expect("saved PC size"))
+    } else {
+        instruction.next(pc, |r| regs.integer(r))?
+    };
+    if next == pc {
+        if instruction.displacement().is_none()
+            && instruction.link_register().is_none()
+            && !(instruction.len() == 2 && instruction.0 & 0xf07f == 0x8002)
+        {
+            return Err(Error::UnsupportedArchitectureFeature(
+                "stepping a syscall returning to itself",
+            ));
+        }
+        if let Some(link) = instruction.link_register() {
+            regs.update(
+                Register::from_repr(link as u16).unwrap(),
+                pc + instruction.len(),
+            );
+            regs.persist(pid)?;
+        }
+        return Ok(vec![]);
+    }
+    Ok(vec![next])
+}
+
+pub struct StepBreakpoints(Vec<Breakpoint>);
+
+impl StepBreakpoints {
+    pub fn install(pid: Pid, targets: &[u64], active: &[&Breakpoint]) -> Result<Self, Error> {
+        let mut points = Self(vec![]);
+        for &target in targets {
+            if active
+                .iter()
+                .any(|b| b.is_enabled() && b.addr.as_u64() == target)
+            {
+                continue;
+            }
+            let point = Breakpoint::new_temporary("", target.into(), pid);
+            point.enable()?;
+            points.0.push(point);
+        }
+        Ok(points)
+    }
+
+    pub fn restore(&mut self) -> Result<(), Error> {
+        let mut errors = vec![];
+        for point in self.0.drain(..).rev() {
+            if let Err(error) = point.disable() {
+                if !matches!(error, Error::Ptrace(Errno::ESRCH)) {
+                    errors.push(error);
+                }
+            }
+        }
+        if errors.is_empty() {
+            Ok(())
+        } else {
+            Err(Error::MultipleErrors(errors))
+        }
+    }
+
+    pub fn discard(&mut self) {
+        self.0.clear();
+    }
+
+    pub fn restore_through(&mut self, pid: Pid) {
+        // A thread may exit while stepping; another stopped thread can restore shared text.
+        for point in &mut self.0 {
+            point.pid = pid;
+        }
+    }
+}
+
+impl Drop for StepBreakpoints {
+    fn drop(&mut self) {
+        if let Err(error) = self.restore() {
+            log::error!("restore stepping breakpoints: {error}");
+        }
+    }
+}
