+//! Native instruction-set details shared by the debugger and its front ends.
+use capstone::prelude::*;
+use nix::{sys::ptrace, unistd::Pid};
+use std::ffi::c_void;
+
+#[cfg(target_arch = "riscv64")]
+pub(super) mod riscv64;
+
+#[cfg(target_arch = "x86_64")]
+pub const BREAKPOINT: [u8; 1] = [0xcc];
+// riscv64gc includes C; a two-byte trap also fits compressed instructions.
+#[cfg(target_arch = "riscv64")]
+pub const BREAKPOINT: [u8; 2] = [0x02, 0x90];
+
+pub fn disassembler() -> Result<Capstone, capstone::Error> {
+    #[cfg(target_arch = "x86_64")]
+    let builder = Capstone::new()
+        .x86()
+        .mode(arch::x86::ArchMode::Mode64)
+        .syntax(arch::x86::ArchSyntax::Att);
+    #[cfg(target_arch = "riscv64")]
+    let builder = Capstone::new()
+        .riscv()
+        .mode(arch::riscv::ArchMode::RiscV64)
+        .extra_mode([arch::riscv::ArchExtraMode::RiscVC].into_iter());
+    builder.build()
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn native_disassembler_initializes() {
+        let cs = super::disassembler().unwrap();
+        #[cfg(target_arch = "riscv64")]
+        let code = [0x05, 0x05, 0x13, 0x05, 0x15, 0x00]; // c.addi a0,1; addi a0,a0,1
+        #[cfg(target_arch = "x86_64")]
+        let code = [0x90, 0x90];
+        let instructions = cs.disasm_all(&code, 0x1000).unwrap();
+        assert_eq!(instructions.len(), 2);
+        assert_eq!(instructions[0].address(), 0x1000);
+        #[cfg(target_arch = "riscv64")]
+        assert_eq!(instructions[1].address(), 0x1002);
+    }
+}
+
+/// Modify only the requested bytes, including at the end of a mapped page.
+pub fn write_bytes(pid: Pid, address: usize, bytes: &[u8]) -> nix::Result<()> {
+    let mut written = 0;
+    while written < bytes.len() {
+        let current = address + written;
+        let aligned = current & !(size_of::<usize>() - 1);
+        let offset = current - aligned;
+        let count = (size_of::<usize>() - offset).min(bytes.len() - written);
+        let mut word = ptrace::read(pid, aligned as *mut c_void)?.to_ne_bytes();
+        word[offset..offset + count].copy_from_slice(&bytes[written..written + count]);
+        unsafe {
+            ptrace::write(
+                pid,
+                aligned as *mut c_void,
+                usize::from_ne_bytes(word) as *mut c_void,
+            )?;
+        }
+        written += count;
+    }
+    Ok(())
+}
