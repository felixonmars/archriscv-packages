+// RISC-V implements GETREGSET/SETREGSET instead of the legacy ptrace requests.
+// glibc's DB_THREAD_SELF reads tp at offset 4 * 8 in NT_PRSTATUS.
+#[cfg(target_arch = "riscv64")]
+unsafe fn riscv_regset(
+    lwpid: libc::pid_t,
+    request: libc::c_uint,
+    note: usize,
+    registers: *mut c_void,
+    len: usize,
+) -> PsErr {
+    let mut iov = libc::iovec {
+        iov_base: registers,
+        iov_len: len,
+    };
+    if libc::ptrace(request, lwpid, note, &mut iov as *mut libc::iovec) == -1 || iov.iov_len != len
+    {
+        PsErr::Err
+    } else {
+        PsErr::Ok
+    }
+}
+
+#[cfg(target_arch = "riscv64")]
+#[no_mangle]
+pub unsafe extern "C" fn ps_lgetregs(
+    _handle: *mut ProcHandle,
+    lwpid: libc::pid_t,
+    registers: *mut c_void,
+) -> PsErr {
+    riscv_regset(lwpid, libc::PTRACE_GETREGSET, 1, registers, 32 * 8)
+}
+
+#[cfg(target_arch = "riscv64")]
+#[no_mangle]
+pub unsafe extern "C" fn ps_lsetregs(
+    _handle: *mut ProcHandle,
+    lwpid: libc::pid_t,
+    registers: *mut c_void,
+) -> PsErr {
+    riscv_regset(lwpid, libc::PTRACE_SETREGSET, 1, registers, 32 * 8)
+}
+
+#[cfg(target_arch = "riscv64")]
+#[no_mangle]
+pub unsafe extern "C" fn ps_lgetfpregs(
+    _handle: *mut ProcHandle,
+    lwpid: libc::pid_t,
+    registers: *mut c_void,
+) -> PsErr {
+    riscv_regset(lwpid, libc::PTRACE_GETREGSET, 2, registers, 33 * 8)
+}
+
+#[cfg(target_arch = "riscv64")]
+#[no_mangle]
+pub unsafe extern "C" fn ps_lsetfpregs(
+    _handle: *mut ProcHandle,
+    lwpid: libc::pid_t,
+    registers: *mut c_void,
+) -> PsErr {
+    riscv_regset(lwpid, libc::PTRACE_SETREGSET, 2, registers, 33 * 8)
+}
