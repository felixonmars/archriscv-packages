--- PKGBUILD
+++ PKGBUILD
@@ -57,6 +57,34 @@
   # /usr/lib/libnode.so uses malloc_usable_size, which is incompatible with fortification level 3
   CFLAGS="${CFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"
   CXXFLAGS="${CXXFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"
+  # https://github.com/riscv-forks/electron/issues/7
+  export CC=/usr/bin/clang
+  export CXX=/usr/bin/clang++
+}
+
+prepare() {
+  cd node
+
+  patch -Np1 -i ../bench-errors.patch
+
+  # Fix truncated RISC-V lazy-compilation jumps in large Wasm modules.
+  patch -Np1 -d deps/v8 -i "$srcdir/v8-wasm-lazy-jump.patch"
+
+  # Disable Highway RVV code in dependent targets as well as Highway itself.
+  patch -Np1 -i ../hwy-broken-rvv.diff
+
+  # Fix inverted floating-point branches in V8's RISC-V backend.
+  patch -Np1 -i ../v8-riscv-float-branch.patch
+
+  # Avoid reserved RVV element-width/register-group combinations.
+  patch -Np1 -d deps/v8 -i "$srcdir/v8-rvv-lmul.patch"
+  patch -Np1 -d deps/v8 -i "$srcdir/v8-rvv-half-lmul.patch"
+
+  # Let WPT discovery recognize unsupported Wasm SIMD as a skipped suite.
+  patch -Np1 -i ../wasm-simd-skip.patch
+
+  # Ten WPT workers still exhaust Node.js worker heaps on riscv64 builders.
+  sed -i 's/concurrency = Math.min(10, concurrency);/concurrency = Math.min(2, concurrency);/' test/common/wpt.js
 }
 
 build() {
@@ -106,7 +134,11 @@
   # https://github.com/nodejs/node/issues/63914
   rm test/parallel/test-snapshot-reproducible.js
 
-  make test-only
+  # https://github.com/nodejs/node/issues/59146
+  rm test/wasi/test-wasi-pthread.js
+
+  # Limit subprocess contention and triple this base timeout on riscv64.
+  make test-only JOBS=2 TEST_CI_ARGS=--timeout=480
 }
 
 package() {
@@ -116,4 +148,20 @@
   install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
 }
 
