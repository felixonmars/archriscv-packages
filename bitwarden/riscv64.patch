--- PKGBUILD
+++ PKGBUILD
@@ -38,7 +38,7 @@
 	sed -i '/"postinstall":/d' package.json
 
 	# Patch build to make it work with system electron
-	export SYSTEM_ELECTRON_VERSION=$(electron$_electronversion -v | sed 's/v//g')
+	export SYSTEM_ELECTRON_VERSION=$(< "/usr/lib/electron$_electronversion/version")
 	export ELECTRONVERSION=$_electronversion
 	sed -i "s|@electronversion@|${ELECTRONVERSION}|" "$srcdir/bitwarden.sh"
 
@@ -52,7 +52,16 @@
 	# patches from opensuse
 	patch -p1 -i "$srcdir/no-sourcemaps.patch"
 	patch -p1 -i "$srcdir/remove-unnecessary-deps.patch"
-	npm ci
+	# Defer install hooks to disable electron-winstaller's Windows-only 7-Zip setup.
+	# https://github.com/electron/windows-installer/pull/614
+	npm ci --allow-git=all --ignore-scripts
+	npm pkg delete scripts.install --prefix node_modules/electron-winstaller
+	# npm 12 disables install scripts required by this lockfile.
+	npm rebuild --allow-git=all --dangerously-allow-all-scripts
+	# RISC-V support from electron-builder PR #8143, reverted upstream in #8427.
+	patch -Np1 -i "$srcdir/bitwarden-electron-builder-riscv64.patch"
+	mkdir -p node_modules/7zip-bin/linux/riscv64
+	ln -s /usr/bin/7za node_modules/7zip-bin/linux/riscv64/7za
 	pushd apps/desktop/desktop_native
 	cargo fetch --locked --target "$(rustc --print host-tuple)"
 	popd
@@ -61,7 +70,7 @@
 build() {
 	cd bitwarden/apps/desktop
 	electronDist=/usr/lib/electron$_electronversion
-	electronVer=$(electron$_electronversion --version | tail -c +2)
+	electronVer=$(< "$electronDist/version")
 	export npm_config_cache="$srcdir/npm_cache"
 	export ELECTRON_SKIP_BINARY_DOWNLOAD=1
 	export CXXFLAGS="$CXXFLAGS -Wno-error"
@@ -120,17 +129,17 @@
 	# Remove empty directories
 	find . -type d -empty -print -delete
 	popd
-	npm exec -c "electron-builder --linux --x64 --dir -c.electronDist=$electronDist \
+	npm exec -c "electron-builder --linux --dir -c.electronDist=$electronDist \
 	             -c.electronVersion=$electronVer"
 }
 
 package(){
 	cd bitwarden/apps/desktop
-	install -vDm644 dist/linux-unpacked/resources/app.asar -t "${pkgdir}/usr/lib/${pkgname}"
+	install -vDm644 dist/linux-riscv64-unpacked/resources/app.asar -t "${pkgdir}/usr/lib/${pkgname}"
 	install -vDm644 build/package.json -t "${pkgdir}/usr/lib/${pkgname}"
 	install -vDm755 build/desktop_proxy -t "${pkgdir}/usr/lib/${pkgname}"
 	install -vDm755 desktop_native/target/release/libprocess_isolation.so -t "${pkgdir}/usr/lib/${pkgname}"
-	cp -vr dist/linux-unpacked/resources/app.asar.unpacked -t "${pkgdir}/usr/lib/${pkgname}"
+	cp -vr dist/linux-riscv64-unpacked/resources/app.asar.unpacked -t "${pkgdir}/usr/lib/${pkgname}"
 
 	for i in 16 32 64 128 256 512 1024; do
 		install -vDm644 resources/icons/${i}x${i}.png "${pkgdir}/usr/share/icons/hicolor/${i}x${i}/apps/${pkgname}.png"
@@ -140,3 +149,7 @@
 	install -vDm755 "${srcdir}/${pkgname}.sh" "${pkgdir}/usr/bin/bitwarden-desktop"
 	install -vDm644 "${srcdir}"/${pkgname}.desktop -t "${pkgdir}"/usr/share/applications
 }
+
+makedepends+=('p7zip')
+source+=(bitwarden-electron-builder-riscv64.patch)
+sha512sums+=('ea7403e25b475703724e6873612a2364ee9d73f2f3d849cadd7ee7f46e7835283636a018e2e029fd6f8a21d532f85e32432a718aa782d763e9614ddee7cf8d0f')
