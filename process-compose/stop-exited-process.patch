@@ -0,0 +1,33 @@
+//go:build !windows
+
+package command
+
+import (
+	"syscall"
+	"testing"
+)
+
+func TestStopExitedProcess(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		parentOnly bool
+	}{
+		{name: "process group"},
+		{name: "parent only", parentOnly: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cmd := BuildCommand("sh", []string{"-c", "exit 0"})
+			cmd.SetCmdArgs()
+			if err := cmd.Start(); err != nil {
+				t.Fatal(err)
+			}
+			if err := cmd.Wait(); err != nil {
+				t.Fatal(err)
+			}
+			// Model a shutdown racing with the state update after Wait reaps the child.
+			if err := cmd.Stop(int(syscall.SIGTERM), tc.parentOnly); err != nil {
+				t.Fatalf("stopping an already-exited process: %v", err)
+			}
+		})
+	}
+}
