--- PKGBUILD
+++ PKGBUILD
@@ -42,6 +42,7 @@
   # Mock Feishu APIs so the media test cannot leak requests into later tests.
   # https://github.com/QwenLM/qwen-code/pull/13170
   patch -p1 -i "$srcdir/feishu-media-test.patch"
+  patch -Np1 -i ../riscv64-tests.patch
   # npm 12 returns pack metadata keyed by package name instead of an array.
   # https://github.com/npm/cli/pull/9247
   sed -i 's/const packs = JSON\.parse(stdout)/const packs = Object.values(JSON.parse(stdout))/' \
@@ -78,13 +79,35 @@
   # https://github.com/nodejs/node/issues/64549
   sed -i "s/it('retains the original write error/it.skip('retains the original write error/" \
     packages/cli/src/acp-integration/acp-output.test.ts
+  # The pinned pnpm release has no riscv64 native binary.
+  printf '\npmOnFail: ignore\n' >> pnpm-workspace.yaml
   pnpm install --frozen-lockfile --ignore-scripts
   # Upstream postinstall applies dependency patches; install scripts are disabled above.
   ./node_modules/.bin/patch-package
+  # Vitest 3.2.7 hard-codes a 60-second worker RPC deadline.
+  patch -d node_modules/vitest -Np1 -i "$srcdir/vitest-rpc-timeout.patch"
+  cargo fetch --locked --manifest-path="$srcdir/tailwindcss-4.3.2/crates/node/Cargo.toml"
+  cargo fetch --locked --manifest-path="$srcdir/lightningcss-1.32.0/node/Cargo.toml"
+  # Jieba's published source commit does not include Cargo.lock.
+  cargo fetch --manifest-path="$srcdir/node-rs-3b2896520f4274d74aab262436e93e2cfbd4966f/packages/jieba/Cargo.toml"
+  npm pkg set 'files[]=jieba.linux-riscv64-gnu.node' --prefix node_modules/@node-rs/jieba
 }
 
 build() {
   cd $pkgname
+  # Build missing native bindings without changing pnpm's locked dependencies.
+  # Jieba's WASI fallback requires SIMD unavailable on the RISC-V builders.
+  cargo build --frozen --release --manifest-path="$srcdir/tailwindcss-4.3.2/crates/node/Cargo.toml"
+  cargo build --frozen --release --manifest-path="$srcdir/lightningcss-1.32.0/node/Cargo.toml"
+  # Keep mimalloc's native objects for Rust's link when C LTO is enabled.
+  CFLAGS="$CFLAGS -ffat-lto-objects" \
+    cargo build --frozen --release --manifest-path="$srcdir/node-rs-3b2896520f4274d74aab262436e93e2cfbd4966f/packages/jieba/Cargo.toml"
+  cp "$srcdir/tailwindcss-4.3.2/target/release/libtailwind_oxide.so" \
+    node_modules/@tailwindcss/oxide/tailwindcss-oxide.linux-riscv64-gnu.node
+  cp "$srcdir/lightningcss-1.32.0/target/release/liblightningcss_node.so" \
+    node_modules/lightningcss/lightningcss.linux-riscv64-gnu.node
+  cp "$srcdir/node-rs-3b2896520f4274d74aab262436e93e2cfbd4966f/target/release/libnode_rs_jieba.so" \
+    node_modules/@node-rs/jieba/jieba.linux-riscv64-gnu.node
   npm run build
   npm run bundle
   local bundled=$(jq '.dependencies + .optionalDependencies | keys' package.json)
@@ -128,7 +151,7 @@
   npm pkg set 'workspaces[]=!packages/mobile-mcp'
   # NODE_OPTIONS gives Node's Web Storage one shared backing file; keep Vitest
   # files serial so another jsdom test cannot clear draft storage mid-test.
-  npm run test --workspaces --if-present -- --testTimeout=30000 --no-file-parallelism --exclude="$test_exclude"
+  npm run test --workspaces --if-present -- --testTimeout=70000 --hookTimeout=70000 --coverage.enabled=false --no-file-parallelism --exclude="$test_exclude"
 }
 
 package() {
@@ -137,3 +160,20 @@
   install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md
   install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
 }
+
