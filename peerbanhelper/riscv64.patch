+  # Match each binding's emnapi prerelease; newer runtimes break initWorker.
+  '@rolldown/binding-wasm32-wasi@1.2.3>@napi-rs/wasm-runtime': 1.2.2
+  '@rolldown/binding-wasm32-wasi@1.2.14>@napi-rs/wasm-runtime': 1.2.5
+packageExtensions:
+  'rolldown@1.2.3':
+    dependencies:
+      '@rolldown/binding-wasm32-wasi': 1.2.3
+  'rolldown@1.2.14':
+    dependencies:
+      '@rolldown/binding-wasm32-wasi': 1.2.14
+EOF
+    pnpm install --no-frozen-lockfile
     popd
 }
 
