-def testComponent(value, exp):
+def normalize_percent_hex(value):
+    # libcurl versions differ in the case of percent-encoded hex digits.
+    if isinstance(value, str):
+        return re.sub(r"%[0-9a-fA-F]{2}", lambda match: match.group().upper(), value)
+    if isinstance(value, list):
+        return [normalize_percent_hex(item) for item in value]
+    if isinstance(value, dict):
+        return {key: normalize_percent_hex(item) for key, item in value.items()}
+    return value
+
