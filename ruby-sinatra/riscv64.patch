--- PKGBUILD
+++ PKGBUILD
@@ -52,6 +52,9 @@
 
   cd "sinatra-${pkgver}"
 
+  # Ruby and Puma startup can exceed the default timeout under qemu-user.
+  patch -Np1 -i "$srcdir/increase-startup-test-timeout.patch"
+
   # update gemspec to allow newer version of the dependencies
   sed --in-place --regexp-extended 's|~>|>=|g' sinatra.gemspec */*.gemspec
 
@@ -232,3 +235,6 @@
   install --verbose -D --mode=0644 "${_licensefile}" --target-directory "${pkgdir}/usr/share/licenses/ruby-${_gemname}/"
   install --verbose -D --mode=0644 *.md --target-directory "${pkgdir}/usr/share/doc/ruby-${_gemname}"
 }
+
+source+=(increase-startup-test-timeout.patch)
+sha512sums+=('a343e9cb28cf2d691aba6828747a071cb65d26e01f72f5c5777a833faf1ff1a8b40f568b0c72823eba6f3a0e7eb03aece1b37db1eea527f5f1645bc800ce6bae')
