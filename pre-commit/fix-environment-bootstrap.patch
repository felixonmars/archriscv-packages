+def test_toolchain_survives_until_cargo_install(tmp_path):
+    toolchains = []
+
+    def cmd_output(*cmd, **kwargs):
+        toolchain = Path(os.environ['RUSTUP_HOME']).joinpath('toolchains')
+        if cmd[:2] == ('rustup', 'toolchain'):
+            toolchain.mkdir()
+            toolchains.append(toolchain)
+        else:
+            assert cmd[:2] == ('cargo', 'install')
+            assert toolchains == [toolchain]
+            assert toolchain.is_dir()
+        return 0, b'', b''
+
+    with mock.patch.object(
+            parse_shebang, 'find_executable', return_value='rustup',
+    ):
+        with mock.patch.object(rust, 'cmd_output_b', side_effect=cmd_output):
+            rust.install_environment(Prefix(str(tmp_path)), '1.56.0', ())
+
+    assert len(toolchains) == 1
+    assert not toolchains[0].exists()
+
