--- PKGBUILD
+++ PKGBUILD
@@ -60,9 +60,12 @@
 
 prepare() {
   cd "${_name}"
-  # Run Steady with the packaged Node.js; upstream's launcher requires exactly 22.22.3.
-  sed -i 's|node scripts/utils/node-tooling.cjs steady|npm exec --package=@stdy/cli@0.22.2 -- steady|' \
+  # Steady's npm package has no riscv64 binary; run the same release from source.
+  sed -i 's|node scripts/utils/node-tooling.cjs steady|deno run -A --config=../steady-0.22.2/deno.json ../steady-0.22.2/cmd/steady.ts|' \
     scripts/run-steady
+
+  # Cold SDK imports contend with 32 pytest workers; cap each example subprocess at 5 minutes.
+  sed -i 's/timeout=15,/timeout=300,/' tests/test_mtls_http_client.py
 }
 
 build() {
@@ -77,8 +80,7 @@
   export PYTHONPATH="$PWD/tmp_install/${site_packages}"
 
   # Start mock server and make sure it's cleaned up on exit
-  export npm_config_yes=true
-  trap 'pkill "npm exec steady"' EXIT
+  trap 'pkill -f "^deno run .*steady"' EXIT
   ./scripts/mock --daemon
 
   # Randomly generated mock API key
@@ -102,3 +104,7 @@
   install -vDm644 src/openai/_vendor/httpx_aiohttp/LICENSE \
     "${pkgdir}/usr/share/licenses/${pkgname}/httpx-aiohttp-LICENSE"
 }
+
+checkdepends=("${checkdepends[@]/npm/deno}")
+source+=("steady-0.22.2.tar.gz::https://github.com/dgellow/steady/archive/refs/tags/v0.22.2.tar.gz")
+b2sums+=('da4d4028879b7ebdf012c25924e487a7af851f9d451441e63e8ad5399acf275d87d0201285543d36c871cd9149eab4eb42e9e954042e6bf5e1311e1e7e24b09e')
