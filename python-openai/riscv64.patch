--- PKGBUILD
+++ PKGBUILD
@@ -59,6 +59,20 @@
 )
 b2sums=('ebfed7ac255ddd159c4482e17312f996f621e3cad3938f20dd20865257c7243170d35f59c00bacddb284c3f2dcfa1b4174804e4a3f83ac5b74400c4a96ffc130')
 
+prepare() {
+  cd "${_name}"
+
+  # Steady's pinned Deno download has no riscv64 build; use the packaged runtime.
+  sed -i \
+    -e "s|source \"\$STEADY_ROOT/scripts/steady/settings\"|STEADY_SOURCE=\"\$STEADY_ROOT/../steady-${_steady_revision}\"|" \
+    -e '/^steady_verify$/d' \
+    -e 's|exec "$DENO_DIRECTORY/$DENO_BINARY"|exec deno|' \
+    scripts/run-steady
+
+  # Cold SDK imports contend with 32 pytest workers; cap each example subprocess at 5 minutes.
+  sed -i 's/timeout=15,/timeout=300,/' tests/test_mtls_http_client.py
+}
+
 build() {
   cd "${_name}"
   python -m build --wheel --no-isolation --skip-dependency-check
@@ -70,10 +84,13 @@
   local site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
   export PYTHONPATH="$PWD/tmp_install/${site_packages}"
 
-  ./scripts/steady/install
+  export DENO_DIR="$PWD/scripts/steady/.cache/deps"
+  export DENO_NO_UPDATE_CHECK=1
+  deno cache --frozen --config "../steady-${_steady_revision}/deno.json" \
+    "../steady-${_steady_revision}/cmd/steady.ts"
 
   # Start mock server and make sure it's cleaned up on exit
-  trap 'pkill -f "$PWD/scripts/steady/.cache/.*/cmd/steady.ts" || true' EXIT
+  trap 'pkill -f "^deno run .*steady" || true' EXIT
   ./scripts/mock --daemon
 
   # Randomly generated mock API key
@@ -97,3 +114,8 @@
   install -vDm644 src/openai/_vendor/httpx_aiohttp/LICENSE \
     "${pkgdir}/usr/share/licenses/${pkgname}/httpx-aiohttp-LICENSE"
 }
+
+_steady_revision=195de4e71f6f87282110b044b454582e7fbc34bb
