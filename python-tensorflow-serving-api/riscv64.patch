+  # Bazel's release binary is x86_64-only, so generate the Python API natively.
+  local _protos=(
+    tensorflow_serving/apis/{classification,get_model_metadata,get_model_status,inference,input,logging,model,model_management,prediction_log,predict,regression,session_service,status}.proto
+    tensorflow_serving/config/{file_system_storage_path_source,log_collector_config,logging_config,model_server_config,platform_config}.proto
+  )
+  local _wheel_dir="${srcdir}/wheel"
+
+  mkdir -p "${srcdir}/dist" "${_wheel_dir}"
+  protoc -I . -I /usr/include -I "${srcdir}/tensorflow-${_tensorflow_commit}" \
+    -I "${srcdir}/tensorflow-${_tensorflow_commit}/third_party/xla" \
+    --python_out="${_wheel_dir}" "${_protos[@]}"
+
+  cp tensorflow_serving/apis/{model_service,prediction_service}_pb2{,_grpc}.py \
+    "${_wheel_dir}/tensorflow_serving/apis"
+  cp tensorflow_serving/tools/pip_package/setup.py "${_wheel_dir}"
+  touch "${_wheel_dir}/tensorflow_serving"/{,apis/,config/}__init__.py
+
+  cd "${_wheel_dir}"
+  python setup.py bdist_wheel --universal --dist-dir "${srcdir}/dist" \
+    --project_name tensorflow-serving-api
+  python setup.py bdist_wheel --universal --dist-dir "${srcdir}/dist" \
+    --project_name tensorflow-serving-api-gpu
 }
