--- PKGBUILD
+++ PKGBUILD
@@ -51,6 +51,7 @@
   git submodule init
   git config submodule.libbpf.url ../$pkgname-libbpf
   git -c protocol.file.allow=always submodule update libbpf
+  patch -Np1 -i ../btf-array-tests.patch
 }
 
 build() {
@@ -63,7 +64,9 @@
 }
 
 check() {
-  ctest --test-dir build --output-on-failure
+  # The single GoogleTest binary is serial and exceeds CTest's 25m default
+  # timeout on riscv64 while still making progress.
+  ctest --test-dir build --output-on-failure --timeout 7200
 }
 
 package() {
@@ -73,3 +76,6 @@
 
   DESTDIR="$pkgdir" cmake --install build
 }
+
+source+=(btf-array-tests.patch)
