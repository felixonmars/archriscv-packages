--- fetch-chromium-release
+++ fetch-chromium-release
@@ -24,11 +24,42 @@
 
 git clone --depth=1 https://chromium.googlesource.com/chromium/tools/depot_tools
 export PATH+=":$PWD/depot_tools" DEPOT_TOOLS_UPDATE=0
-# system python fails to load six.moves module
-#export VPYTHON_BYPASS='manually managed python not supported by chrome operations'
+
+# gsutil needs Python 3.11, but depot_tools' bundled wheels are unavailable on
+# riscv64. Use a local environment for both legacy and TOML vpython configs.
+printf 'python_version: "3.11"\n' > rv.vpython3
+vpython3 -vpython-spec rv.vpython3 -m venv rv-venv
+source rv-venv/bin/activate
+python -m pip install httplib2==0.13.1 six==1.10.0 requests==2.31.0 crcmod==1.7
+export VPYTHON_BYPASS='manually managed python not supported by chrome operations'
+
+# Sync often fails on SG2042 with:
+# lockfile.LockError: Error locking /build/chromium/src/chromium-checkout/depot_tools/external_bin/gsutil/gsutil_5.35 (err: [Errno 11] Resource temporarily unavailable)
+retry() {
+  local retries=$1
+  shift
+
+  local count=0
+  until "$@"; do
+    exit=$?
+    wait=$((2 ** $count))
+    count=$(($count + 1))
+    if [ $count -lt $retries ]; then
+      echo "Retry $count/$retries exited $exit, retrying in $wait seconds..."
+      sleep $wait
+    else
+      echo "Retry $count/$retries exited $exit, no more retries left."
+      return $exit
+    fi
+  done
+  return 0
+}
+
 
 git clone -b $VERSION --depth=2 https://chromium.googlesource.com/chromium/src
-gclient sync --no-history --nohooks
+patch -Np1 -d src < ../DEPS-remove-native-binaries.diff
+retry 5 gclient sync --no-history --nohooks
