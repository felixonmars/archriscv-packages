--- PKGBUILD
+++ PKGBUILD
@@ -23,18 +23,35 @@
 prepare() {
   cd $pkgname
 
+  patch -Np2 -d ../rquickjs-sys-0.11.0 -i "$srcdir/rquickjs-bindgen-target.patch"
+  patch -Np1 -d ../aws-lc-sys-0.45.0 -i "$srcdir/aws-lc-cc-cache.patch"
+  sed -i 's/^default = \["gxhash"\]/default = []/' src/config/Cargo.toml
+  sed -i '/^rquickjs = /s/features = \[/&"bindgen", /' Cargo.toml
+  sed -i '/^\[patch\.crates-io\]$/a rquickjs-sys = { path = "../rquickjs-sys-0.11.0" }' Cargo.toml
+  sed -i '/^\[patch\.crates-io\]$/a aws-lc-sys = { path = "../aws-lc-sys-0.45.0" }' Cargo.toml
+
   # TODO: Temporary fix for https://github.com/openobserve/openobserve/issues/14450
   cargo update
 
   # Note: We're not fetching the stable toolchain via rustup here
   # because upstream uses a specific version in a toolchain file.
   cargo fetch --locked --target host-tuple
+  cargo fetch --locked --target host-tuple --manifest-path="$srcdir/lightningcss-1.32.0/node/Cargo.toml"
+  cargo fetch --locked --target host-tuple --manifest-path="$srcdir/tailwindcss-4.3.3/crates/node/Cargo.toml"
 }
 
 build() {
   cd $pkgname/web
 
+  export RUSTFLAGS+=" -C link-arg=-fuse-ld=lld"
+  cargo build --frozen --release --manifest-path="$srcdir/lightningcss-1.32.0/node/Cargo.toml"
+  cargo build --frozen --release --manifest-path="$srcdir/tailwindcss-4.3.3/crates/node/Cargo.toml"
+
   npm install
+  cp "$srcdir/lightningcss-1.32.0/target/release/liblightningcss_node.so" \
+    node_modules/lightningcss/lightningcss.linux-riscv64-gnu.node
+  cp "$srcdir/tailwindcss-4.3.3/target/release/libtailwind_oxide.so" \
+    node_modules/@tailwindcss/oxide/tailwindcss-oxide.linux-riscv64-gnu.node
   # We ave to increase the heap limit as otherwise we'd get
   # Ineffective mark-compacts near heap limit Allocation failed - JavaScript heap out of memory"
   NODE_OPTIONS="--max-old-space-size=8192" npm run build
@@ -43,7 +60,6 @@
 
   CFLAGS+=' -ffat-lto-objects'
   CXXFLAGS+=' -ffat-lto-objects'
-  export RUSTFLAGS="-C target-feature=+aes,+sse2"
   export RUSTONIG_SYSTEM_LIBONIG=1
   export LIBSQLITE3_SYS_USE_PKG_CONFIG=1
   export ZSTD_SYS_USE_PKG_CONFIG=1
@@ -63,3 +79,17 @@
 }
 
