--- PKGBUILD
+++ PKGBUILD
@@ -52,6 +52,13 @@
   # -Werror, not even once
   sed -e '/Werror/d' -i mypyc/build.py
   patch -Np1 < ../$pkgname-exclude-tests.patch
+  # RISC-V builders can exceed upstream's short process and lock timeouts.
+  sed -i \
+    -e 's/^WORKER_START_TIMEOUT: Final = .*/WORKER_START_TIMEOUT: Final = 30/' \
+    -e 's/^WORKER_SHUTDOWN_TIMEOUT: Final = .*/WORKER_SHUTDOWN_TIMEOUT: Final = 30/' \
+    -e 's/^WORKER_CONNECTION_TIMEOUT: Final = .*/WORKER_CONNECTION_TIMEOUT: Final = 60/' \
+    mypy/defaults.py
+  patch -Np1 < ../riscv64-timeouts.patch
 }
 
 build() {
@@ -85,3 +92,6 @@
   python -m installer --destdir="$pkgdir" dist/*.whl
   install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
 }
+
+source+=('riscv64-timeouts.patch')
+b2sums+=('bae7425bc04bf70429395c9ee7f076399eb9c850124137d76bd8db84a646b955b85cadee6695e85ea62287bc0cea8f0319bd4820aac4fd044be8e0c1a12d799b')
