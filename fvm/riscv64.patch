--- PKGBUILD
+++ PKGBUILD
@@ -17,6 +17,10 @@
 prepare() {
 	cd "${pkgname}/"
 
+	# Keep the riscv64 checks meaningful while avoiding upstream
+	# wall-clock ceilings that only fail on slow builders.
+	patch -Np0 -i ../riscv64-test-deadlines.patch
+
 	# Disable analytics
 	dart --disable-analytics
 
@@ -31,7 +35,9 @@
 
 check() {
 	cd "${pkgname}/"
-	dart test
+	# The sdk tests need Flutter artifacts unavailable on riscv64 builders.
+	# Run test files serially so nested Dart processes are not starved.
+	dart test --concurrency=1 --exclude-tags=sdk
 }
 
 package() {
@@ -39,3 +45,6 @@
 	install -Dm755 "bin/${pkgname}" -t "${pkgdir}/usr/bin/"
 	install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}/"
 }
+
+source+=("riscv64-test-deadlines.patch")
+sha256sums+=('60f97ed7096e87f204aac975f42622862229aab4cfd4320c0fd2b25d5f4c1047')
