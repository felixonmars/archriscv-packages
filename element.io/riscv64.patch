--- PKGBUILD
+++ PKGBUILD
@@ -50,27 +50,56 @@
   # Specify electron version in launcher
   sed -i "s|@ELECTRON@|${_electron}|" element-desktop.sh
 
+  # Nx's WASI fallback does not provide the WorkspaceContext API.
+  cargo build --release --locked --manifest-path "${srcdir}/nx-23.1.0/packages/nx/Cargo.toml"
+  # Rolldown does not publish its riscv64 N-API binding.
+  cargo build --release --locked --manifest-path "${srcdir}/rolldown-1.1.5/crates/rolldown_binding/Cargo.toml"
+  # Lightning CSS does not publish its riscv64 N-API binding.
+  cargo build --release --locked --manifest-path "${srcdir}/lightningcss-1.32.0/node/Cargo.toml"
+  export ELECTRON_SKIP_BINARY_DOWNLOAD=1
+  export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
+
   cd element-web
   patch -p1 < "${srcdir}/autolaunch.patch"
+  cd apps/desktop
+  patch -p0 < "${srcdir}/element-desktop-riscv64-support.patch"
+  cd ../..
   sed -e 's|"error"|"warn"|' -i package.json
-  pnpm install
+  # Patch builder-util before the postinstall hook probes the host architecture.
+  pnpm install --ignore-scripts
 
   cd apps/desktop
   sed -i 's/target: \["tar.gz", "deb"\]/target: ["dir"]/' electron-builder.ts
+  sed -i '/    npmRebuild: true,/c\    npmRebuild: false,\n    electronDist: "/usr/lib/'"${_electron}"'",' electron-builder.ts
   sed -i 's|"https://packages.element.io/desktop/update/"|null|' element.io/release/config.json
-  pnpm install
+  pnpm install --ignore-scripts
+
+  cp "${srcdir}/nx-23.1.0/target/release/libnx.so" ../../node_modules/.pnpm/nx@23.1.0/node_modules/nx/dist/src/native/nx.linux-riscv64-gnu.node
+  cp "${srcdir}/rolldown-1.1.5/target/release/librolldown_binding.so" ../../node_modules/.pnpm/rolldown@1.1.5/node_modules/rolldown/dist/shared/rolldown-binding.linux-riscv64-gnu.node
+  cp "${srcdir}/lightningcss-1.32.0/target/release/liblightningcss_node.so" ../../node_modules/.pnpm/lightningcss@1.32.0/node_modules/lightningcss/lightningcss.linux-riscv64-gnu.node
+  patch -d ../../node_modules/.pnpm/builder-util@26.15.3/node_modules/builder-util -p0 < "${srcdir}/builder-util-riscv64.patch"
+  cd ../..
+  pnpm rebuild
+  pnpm run postinstall
+  cd apps/desktop
+
+  pnpm run hak fetch matrix-seshat
+  pushd .hak/matrix-seshat/riscv64gc-unknown-linux-gnu/build/
+  echo -e "[patch.crates-io]\nnix = { git = 'https://github.com/kxxt/nix.git', branch = 'archrv-element-fix' }" >> Cargo.toml
+  cargo update -p nix
+  popd
 }
 
 build() {
   export NODE_OPTIONS=--openssl-legacy-provider
   cd element-web/apps/web
-  VERSION=${pkgver} pnpm run build
+  NX_DAEMON=false VERSION=${pkgver} pnpm run build
 
   cd ../desktop
   export SQLCIPHER_BUNDLED=1
   export CFLAGS+=" -ffat-lto-objects"
   pnpm run build:native
-  pnpm run build --publish never
+  NX_DAEMON=false pnpm run build --publish never
 }
 
 package_element-web() {
@@ -113,3 +142,15 @@
   install -Dm644 ../web/res/themes/element/img/logos/element-logo.svg "${pkgdir}"/usr/share/icons/hicolor/scalable/apps/io.element.Element.svg
   install -Dm644 build/icon.png "${pkgdir}"/usr/share/icons/hicolor/512x512/apps/io.element.Element.png
 }
+
+makedepends+=(cmake)
+source+=(nx-23.1.0.tar.gz::https://github.com/nrwl/nx/archive/refs/tags/23.1.0.tar.gz
+         rolldown-1.1.5.tar.gz::https://github.com/rolldown/rolldown/archive/refs/tags/v1.1.5.tar.gz
+         lightningcss-1.32.0.tar.gz::https://github.com/parcel-bundler/lightningcss/archive/refs/tags/v1.32.0.tar.gz
+         element-desktop-riscv64-support.patch
+         builder-util-riscv64.patch)
