--- PKGBUILD
+++ PKGBUILD
@@ -35,6 +35,7 @@
 prepare() {
 	local zigdir="$srcdir/zig-global-cache" f d n
 	cd "$_archive"
+	PATH="$srcdir/zig-riscv64-linux-0.17.0:$PATH" \
 	ZIG_GLOBAL_CACHE_DIR="$zigdir/" ./nix/build-support/fetch-zig-cache.sh
 	for f in "$zigdir"/p/*.tar.gz; do
 		d="${f%.tar.gz}"
@@ -52,13 +53,14 @@
 
 build() {
 	cd "$_archive"
-	DESTDIR=build zig build \
+	DESTDIR=build "$srcdir/zig-riscv64-linux-0.17.0/zig" build \
 		--summary all \
 		--prefix "/usr" \
 		--system "$srcdir/zig-global-cache/p" \
 		-Doptimize=ReleaseFast \
 		-Dgtk-x11=true \
 		-Dcpu=baseline \
+		-Dsimd=false \
 		-Dpie=true \
 		-Demit-docs \
 		-Dversion-string="$pkgver-arch$pkgrel" \
@@ -103,3 +105,7 @@
 	mkdir -p "$pkgdir"/usr/share/nautilus-python/
 	cp -r build/usr/share/nautilus-python/* "$pkgdir"/usr/share/nautilus-python/
 }
+
+makedepends=(${makedepends[@]/zig})
+source+=('https://ziglang.org/download/0.17.0/zig-riscv64-linux-0.17.0.tar.xz')
+sha256sums+=('18ff032ac6cecf746a84259f6463264f13160ff88bc3b80722ce06f9479b82ed')
