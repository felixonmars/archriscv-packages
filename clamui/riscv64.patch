--- PKGBUILD
+++ PKGBUILD
@@ -33,14 +33,37 @@
 
 prepare() {
   cd $pkgname
+  # The lockfile marks RISC-V optional dependencies with an unsupported CPU.
+  sed -i '/linux-riscv64/s/"cpu": "none"/"cpu": "riscv64"/' desktop/bun.lock
   bun install --cwd desktop --frozen-lockfile
 
   CARGO_HOME="$srcdir/cargo-home" \
     cargo fetch --locked --target "$(rustc --print host-tuple)"
+
+  cd "$srcdir/rolldown-1.2.16"
+  CARGO_HOME="$srcdir/cargo-home" \
+    cargo fetch --locked --target riscv64gc-unknown-linux-gnu
+
+  cd "$srcdir/lightningcss-1.33.0"
+  CARGO_HOME="$srcdir/cargo-home" \
+    cargo fetch --locked --target riscv64gc-unknown-linux-gnu
 }
 
 build() {
-  cd $pkgname
+  # Vite's Rolldown and Lightning CSS dependencies do not ship RISC-V bindings.
+  cd rolldown-1.2.16
+  CARGO_HOME="$srcdir/cargo-home" \
+    cargo build --frozen --release -p rolldown_binding --target riscv64gc-unknown-linux-gnu
+  install -m755 target/riscv64gc-unknown-linux-gnu/release/librolldown_binding.so \
+    "$srcdir/$pkgname/desktop/node_modules/rolldown/dist/shared/rolldown-binding.linux-riscv64-gnu.node"
+
+  cd "$srcdir/lightningcss-1.33.0"
+  CARGO_HOME="$srcdir/cargo-home" \
+    cargo build --frozen --release -p lightningcss_node --target riscv64gc-unknown-linux-gnu
+  install -m755 target/riscv64gc-unknown-linux-gnu/release/liblightningcss_node.so \
+    "$srcdir/$pkgname/desktop/node_modules/lightningcss/lightningcss.linux-riscv64-gnu.node"
+
+  cd "$srcdir/$pkgname"
 
   bun run --cwd desktop build
 
@@ -73,3 +96,9 @@
     install -Dm644 "$mo" "$pkgdir/usr/share/locale/$lang/LC_MESSAGES/clamui.mo"
   done
 }
+
+makedepends+=(cmake)
