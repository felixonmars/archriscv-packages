--- PKGBUILD
+++ PKGBUILD
@@ -42,6 +42,10 @@
   # Adapt supplied sockets and async streams to python-socks 3.
   # https://github.com/jawah/urllib3.future/issues/437
   patch -p1 < ../python-socks-v3.patch
+  # Keep the large TLS response test's connection alive until its reuse check.
+  patch -p1 -i "$srcdir/async-large-response-reuse.patch"
+  # Read complete request bodies before replying in the content framing tests.
+  patch -p1 -i "$srcdir/content-framing.patch"
 }
 
 build() {
@@ -64,3 +68,7 @@
   python -m installer --destdir="$pkgdir" dist/*.whl
   install -Dm644 LICENSE.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
 }
+
+source+=(async-large-response-reuse.patch content-framing.patch)
