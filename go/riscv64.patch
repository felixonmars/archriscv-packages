--- PKGBUILD
+++ PKGBUILD
@@ -35,8 +35,8 @@
             'SKIP')
 
 build() {
-  export GOARCH=amd64
-  export GOAMD64=v1 # make sure we're building for the right x86-64 version
+  export GOARCH=riscv64
+  export GORISCV64=rva20u64 # make sure we're building for the right riscv64 version
   export GOROOT_FINAL=/usr/lib/go
   export GOROOT_BOOTSTRAP=/usr/lib/go
 
@@ -60,7 +60,7 @@
   cd "$pkgname"
 
   install -d "$pkgdir/usr/bin" "$pkgdir/usr/lib/go" "$pkgdir/usr/share/doc/go" \
-    "$pkgdir/usr/lib/go/pkg/linux_amd64_"{dynlink,race}
+    "$pkgdir/usr/lib/go/pkg/linux_riscv64_"{dynlink,race}
 
   cp -a bin pkg src lib misc api test "$pkgdir/usr/lib/go"
   # We can't strip all binaries and libraries,
@@ -87,4 +87,15 @@
   install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
 }
 
+prepare() {
+  cd $pkgname
+
+  patch -F0 -p1 -i ../fix-riscv64-cputicks.patch
+  patch -F0 -p1 -i ../fix-gdb-autotmp-types.patch
+}
+
+source+=(fix-riscv64-cputicks.patch fix-gdb-autotmp-types.patch)
+sha256sums+=('c36f616ec2f1e7747619f7802ab901c34d1c0d94567209667ceb1462d31142d3'
+            '2daf68b24ac45ebe5a1a88deb4b37f6f5ba4b997598ade7ab6dfff9e41130492')
+
 # vim: ts=2 sw=2 et
