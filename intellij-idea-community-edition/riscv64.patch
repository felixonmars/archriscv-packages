 prepare() {
-  cd intellij-community
-
-  # build system doesn't like symlinks
-  mv "${srcdir}"/idea-android android
+  patch -d JetBrains-IDE-Multiarch -Np1 < multiarch-riscv64.patch
+  patch -d skiko -Np1 < skiko-riscv64.patch
+  patch -d skia-${_skiaver} -Np1 < skia-riscv64.patch
+
+  cd JetBrains-IDE-Multiarch
+
+  sed -i '/^natives\.linux\.riscv64\.url=/d' config/natives.properties
+  sed -i "s/^default.version=.*/default.version=${pkgver}/" config/product.properties
+  mkdir -p build/download/ide
+  ln -sf "${srcdir}/idea-${pkgver}-aarch64.tar.gz" \
+    "build/download/ide/ideaIC-${pkgver}-aarch64.tar.gz"
 }
 
 build() {
-  cd intellij-community
-  
   export JAVA_HOME="/usr/lib/jvm/java-${_jdkver}-openjdk"
   export PATH="/usr/lib/jvm/java-${_jdkver}-openjdk/bin:$PATH"
-  export MAVEN_REPOSITORY=${srcdir}/.m2/repository
 
-  ./installers.cmd -Dintellij.build.use.compiled.classes=false -Dintellij.build.target.os=linux -Dintellij.build.target.arch=x64 -Dbuild.number="${_build}"
-  tar -xf out/idea-ce/artifacts/ideaIC-${_build}.tar.gz -C "${srcdir}"
+  cd skia-${_skiaver}
+  GIT_SYNC_DEPS_SKIP_EMSDK=1 python tools/skia_release/build.py \
+    --skia-dir . --target linux --machine riscv64 --gpu-as-extension
+
+  cd "${srcdir}/skiko"
+  ./gradlew -p skiko awtJar skikoJvmRuntimeJarLinuxRiscv64 \
+    -Pskia.dir="${srcdir}/skia-${_skiaver}" \
+    -Pdeploy.version="${_skikover}" -Pdeploy.release=true
+
+  cd "${srcdir}/JetBrains-IDE-Multiarch"
+  ./gradlew transformIC-riscv64 -Pjdk.linux.riscv64.url=
+  tar -xf build/target/ideaIC-${pkgver}+0-riscv64.tar.gz -C "${srcdir}"
+
+  mkdir -p "${srcdir}/skiko-classes"
+  cd "${srcdir}/skiko-classes"
+  bsdtar -xf "${srcdir}/skiko/skiko/build/libs/skiko-awt-${_skikover}.jar" \
+    'org/jetbrains/skiko/Arch*.class' 'org/jetbrains/skiko/OsArch_jvmKt*.class'
+  jar uf "${srcdir}/idea-oss/lib/intellij.libraries.skiko.jar" org
+
+  cd "${srcdir}/idea-oss/lib/skiko-awt-runtime-all"
+  rm libskiko-linux-arm64.so
+  bsdtar -xf "${srcdir}/skiko/skiko/build/libs/skiko-${_skikover}-linux-riscv64.jar" \
+    libskiko-linux-riscv64.so
 }
 
 package() {
   cd idea-oss
 
   install -dm 755 "${pkgdir}"/usr/share/{licenses,idea,icons/hicolor/{128x128,scalable}/apps}
-  cp -dr --no-preserve='ownership' bin lib plugins jbr "${pkgdir}"/usr/share/idea/
+  cp -dr --no-preserve='ownership' bin lib plugins modules "${pkgdir}"/usr/share/idea/
+  ln -s /usr/lib/jvm/java-${_jrever}-openjdk "${pkgdir}"/usr/share/idea/jbr
   cp -dr --no-preserve='ownership' license "${pkgdir}"/usr/share/licenses/idea
   ln -s /usr/share/idea/bin/idea.png "${pkgdir}"/usr/share/icons/hicolor/128x128/apps/
   ln -s /usr/share/idea/bin/idea.svg "${pkgdir}"/usr/share/icons/hicolor/scalable/apps/
@@ -61,4 +89,24 @@
   install -Dm 644 product-info.json -t "${pkgdir}"/usr/share/idea
 }
 
