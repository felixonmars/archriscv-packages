--- PKGBUILD
+++ PKGBUILD
@@ -12,6 +12,8 @@
   'curl'
   'glibc'
   'icu'
+  'libgcc'
+  'libstdc++'
   'ripgrep'
   'tar'
 )
@@ -20,7 +22,10 @@
 #)
 makedepends=(
   'bun'
+  'cmake'
   'git'
+  'node-gyp'
+  'nodejs'
 )
 optdepends=(
   'wl-clipboard: clipboard support on Wayland'
@@ -36,11 +41,39 @@
 prepare() {
   cd $pkgname
   sed -i 's|"packageManager": "bun@1.4.2"|"packageManager": "bun@1.4.0"|' package.json
-  bun install --frozen-lockfile --ignore-scripts
+  patch -Np1 -i ../wasm-css.patch
+  patch -Np1 -i ../riscv64-target.patch
+  cp ../fix-oxide-worker-exit.patch ../opentui-riscv64.patch patches/
+  # The lockfile records RISC-V optional dependencies with an unsupported CPU.
+  sed -i '/linux-riscv64/s/"cpu": "none"/"cpu": "riscv64"/' bun.lock
+  # Install Oxide's threaded WASM fallback on the host architecture.
+  sed -i '/"@tailwindcss\/oxide-wasm32-wasi":/s/"cpu": "none"/"cpu": "riscv64"/' bun.lock
+  bun install --ignore-scripts
+
+  cd "$srcdir/opentui-0.5.10"
+  patch -Np1 -i ../opentui-translate-c.patch
+  cd packages/native
+  bash scripts/prepare-zig-deps.sh
 }
 
 build() {
-  cd $pkgname/packages/cli
+  # Parcel does not publish a RISC-V watcher addon; retain native inotify support.
+  cd "$srcdir/$pkgname/packages/core/node_modules/@parcel/watcher"
+  node-gyp rebuild --nodedir=/usr
+
+  # Koffi's prebuilt RISC-V addon requires RVV and crashes on baseline CPUs.
+  cd "$srcdir/package"
+  node ./cnoke.cjs -P . -D src/koffi --release \
+    -d "CMAKE_C_FLAGS=$CFLAGS -march=rv64gc -mabi=lp64d" \
+    -d "CMAKE_CXX_FLAGS=$CXXFLAGS -march=rv64gc -mabi=lp64d" \
+    -d 'CMAKE_ASM_FLAGS=-march=rv64gc -mabi=lp64d'
+  cp build/koffi/linux_riscv64d/koffi.node "$srcdir/$pkgname/packages/cli/node_modules/@opentui/core/"
+
+  # OpenTUI 0.5.10 needs Zig 0.16.0 and does not publish a RISC-V renderer.
+  cd "$srcdir/opentui-0.5.10/packages/native"
+  "$srcdir/zig-riscv64-linux-0.16.0/zig" build -Doptimize=ReleaseFast -Dlibrary-target=riscv64-linux-gnu.2.27
+
+  cd "$srcdir/$pkgname/packages/cli"
   OPENCODE_VERSION=$pkgver bun run ./script/build.ts --single --baseline --skip-install
 }
 
@@ -61,9 +94,12 @@
   cd $pkgname
   case $CARCH in
   aarch64) dir=cli-linux-arm64 ;;
+  riscv64) dir=cli-linux-riscv64 ;;
   x86_64) dir=cli-linux-x64-baseline ;;
   esac
   install -vDm755 -t "$pkgdir/usr/bin" "packages/cli/dist/$dir/bin/opencode"
+  install -vDm755 -t "$pkgdir/usr/lib/opencode" \
+    "$srcdir/opentui-0.5.10/packages/native/lib/riscv64-linux-gnu.2.27/libopentui.so"
 
   install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
 
@@ -72,3 +108,17 @@
   "$pkgdir/usr/bin/opencode" --completions zsh \
     | install -vDm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_opencode"
 }
