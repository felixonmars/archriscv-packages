--- PKGBUILD
+++ PKGBUILD
@@ -36,7 +36,22 @@
 
 prepare() {
   cd $pkgbase
-  bun install --frozen-lockfile --ignore-scripts
+  patch -Np1 -i ../wasm-css.patch
+  patch -Np1 -i ../riscv64-target.patch
+  cp ../fix-oxide-worker-exit.patch ../opentui-riscv64.patch patches/
+  # The lockfile records RISC-V optional dependencies with an unsupported CPU.
+  sed -i '/linux-riscv64/s/"cpu": "none"/"cpu": "riscv64"/' bun.lock
+  # Install Oxide's threaded WASM fallback on the host architecture.
+  sed -i '/"@tailwindcss\/oxide-wasm32-wasi":/s/"cpu": "none"/"cpu": "riscv64"/' bun.lock
+  bun install --ignore-scripts
+
+  cd "$srcdir/opentui-0.9.4/packages/native"
+  bash scripts/prepare-zig-deps.sh
+
+  cd "$srcdir/rolldown-1.2.5"
+  cargo fetch --locked --target riscv64gc-unknown-linux-gnu
+
+  cd "$srcdir/$pkgbase"
 
   # resourcesPath points to the system electron dir, use our install dir instead
   grep -rl 'process\.resourcesPath' packages/desktop/src/main \
@@ -44,14 +59,41 @@
 }
 
 build() {
+  # Rolldown's WASM binding requires SIMD; build the missing baseline RISC-V addon.
+  cd "$srcdir/rolldown-1.2.5"
+  CFLAGS="$CFLAGS -ffat-lto-objects" \
+    cargo build --frozen --release -p rolldown_binding --target riscv64gc-unknown-linux-gnu
+  install -m755 target/riscv64gc-unknown-linux-gnu/release/librolldown_binding.so \
+    "$srcdir/$pkgbase/node_modules/rolldown/dist/shared/rolldown-binding.linux-riscv64-gnu.node"
+
+  # Parcel does not publish a RISC-V watcher addon; retain native inotify support.
+  cd "$srcdir/$pkgbase/packages/core/node_modules/@parcel/watcher"
+  node-gyp rebuild --nodedir=/usr
+
+  # Koffi's prebuilt RISC-V addon requires RVV and crashes on baseline CPUs.
+  cd "$srcdir/package"
+  node ./cnoke.cjs -P . -D src/koffi --release \
+    -d "CMAKE_C_FLAGS=$CFLAGS -march=rv64gc -mabi=lp64d" \
+    -d "CMAKE_CXX_FLAGS=$CXXFLAGS -march=rv64gc -mabi=lp64d" \
+    -d 'CMAKE_ASM_FLAGS=-march=rv64gc -mabi=lp64d'
+  cp build/koffi/linux_riscv64d/koffi.node "$srcdir/$pkgbase/packages/cli/node_modules/@opentui/core/"
+
+  # OpenTUI 0.9.4 needs Zig 0.17.1 and does not publish a RISC-V renderer.
+  cd "$srcdir/opentui-0.9.4/packages/native"
+  "$srcdir/zig-riscv64-linux-0.17.1/zig" build -Doptimize=ReleaseFast -Dlibrary-target=riscv64-linux-gnu.2.27
+
   # build CLI
   cd "$srcdir/$pkgbase/packages/cli"
   case $CARCH in
     aarch64) target=linux-arm64 ;;
+    riscv64) target=linux-riscv64 ;;
     x86_64) target=linux-x64-baseline ;;
   esac
   OPENCODE_TARGET=$target OPENCODE_VERSION=$pkgver bun run ./script/build.ts --skip-install
 
+  # Desktop packaging only supports x64 and arm64 and lacks a RISC-V node-pty addon.
+  return
+
   # build desktop, see packages/desktop/README.md and script/build.ts
   # (picks up the CLI from packages/cli/dist)
   cd "$srcdir/$pkgbase/packages/desktop"
@@ -92,13 +134,17 @@
     'wl-clipboard: clipboard support on Wayland'
     'xclip: clipboard support on X11'
   )
+  depends+=('libgcc' 'libstdc++')
 
   cd $pkgbase
   case $CARCH in
     aarch64) target=linux-arm64 ;;
+    riscv64) target=linux-riscv64 ;;
     x86_64) target=linux-x64-baseline ;;
   esac
   install -vDm755 -t "$pkgdir/usr/bin" "packages/cli/dist/cli-$target/bin/opencode"
+  install -vDm755 -t "$pkgdir/usr/lib/opencode" \
+    "$srcdir/opentui-0.9.4/packages/native/lib/riscv64-linux-gnu.2.27/libopentui.so"
 
   install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
 
@@ -146,3 +192,21 @@
 
   install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" ../../LICENSE
 }
