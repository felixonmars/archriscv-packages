--- PKGBUILD
+++ PKGBUILD
@@ -21,11 +21,14 @@
 
 build() {
   cd "$pkgname-$pkgver"
+  # GNU BFD rejects --icf=safe from the devtools Rust flags.
+  export RUSTFLAGS+=" -C link-arg=-fuse-ld=lld"
   cargo build --release --frozen
 }
 
 check() {
   cd "$pkgname-$pkgver"
+  export RUSTFLAGS+=" -C link-arg=-fuse-ld=lld"
   cargo test --frozen --all --lib -- --test-threads=1
 }
 
@@ -38,3 +41,5 @@
 }
 
 # vim:set ts=2 sw=2 et:
+
+makedepends+=('lld')
